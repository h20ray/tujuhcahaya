EMDASH_ENCRYPTION_KEY=your_encryption_key_here

# Cloudflare R2 / S3 Media Storage Configuration
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=xlocal
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto
S3_PUBLIC_URL=https://media.xlocal.id
