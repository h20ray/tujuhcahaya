EMDASH_ENCRYPTION_KEY=your_encryption_key_here

# Site URL (optional for dev, required in production reverse proxy)
# SITE_URL=https://www.tujuhcahaya.com

# Cloudflare R2 / S3 Media Storage Configuration
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=xlocal
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto
S3_PUBLIC_URL=https://media.xlocal.id

# Login dengan Google (OAuth 2.0 Web Client from Google Cloud Console)
# Redirect URIs to configure in Google Cloud Console:
#   Production: https://www.tujuhcahaya.com/_emdash/api/auth/oauth/google/callback
#   Local dev:  http://localhost:4321/_emdash/api/auth/oauth/google/callback
EMDASH_OAUTH_GOOGLE_CLIENT_ID=
EMDASH_OAUTH_GOOGLE_CLIENT_SECRET=
