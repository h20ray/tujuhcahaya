---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import C7PortableText from "../components/editorial/C7PortableText.astro";
import Base from "../layouts/Base.astro";
import C7Badge from "../components/ui/C7Badge.astro";
import C7PostCard from "../components/editorial/C7PostCard.astro";
import C7PostSidebar from "../components/editorial/C7PostSidebar.astro";
import C7AuthorCard from "../components/editorial/C7AuthorCard.astro";
import {
	calc7cReadingTime,
	format7cDate,
	get7cRelatedPosts,
	resolve7cFeaturedImage,
	resolve7cAuthor,
} from "../lib/7c-cms";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

// 1. Check posts collection first (matches WordPress /%postname%/ structure)
let isPost = true;
let { entry, cacheHint } = await getEmDashEntry("posts", slug);

// 2. Fallback to pages collection (e.g. /about-us, /privacy-policy)
if (!entry) {
	isPost = false;
	const pageResult = await getEmDashEntry("pages", slug);
	entry = pageResult.entry;
	cacheHint = pageResult.cacheHint;
}

if (!entry) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const tags = entry.data.terms?.tag ?? [];
const categories = entry.data.terms?.category ?? [];
const readingTimeMin = calc7cReadingTime(entry.data.content);
const formattedDate = format7cDate(entry.data.publishedAt, "id");

// Fetch 3 related posts if this is a post
const { posts: relatedPosts } = isPost
	? await get7cRelatedPosts(categories[0]?.slug, slug, 3, "id")
	: { posts: [] };

const heroImage = resolve7cFeaturedImage(entry.data.featured_image, entry.data.title);
const ogImage = seo.ogImage || heroImage.url;
const authorProfile = resolve7cAuthor((entry.data as any)?.byline, "id");
const authorName = authorProfile.name;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={ogImage}
	content={{ collection: isPost ? "posts" : "pages", id: entry.data.id, slug }}
>
	<!-- Fixed Top Reading Progress Bar -->
	<div id="reading-progress-bar" aria-hidden="true"></div>

	<div class="article-container">
		{isPost ? (
			<article class="single-article" data-single-post-slug={slug}>
				<!-- Semantic Breadcrumbs -->
				<nav class="c7-breadcrumb" aria-label="Navigasi Jejak Halaman">
					<a href="/" class="c7-breadcrumb-link">Beranda</a>
					<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
					{categories.length > 0 ? (
						<>
							<a href={`/category/${categories[0].slug}`} class="c7-breadcrumb-link">{categories[0].label}</a>
							<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</>
					) : (
						<>
							<a href="/posts" class="c7-breadcrumb-link">Arsip Liputan</a>
							<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</>
					)}
					<span class="c7-breadcrumb-current" aria-current="page">
						{entry.data.title}
					</span>
				</nav>

				<!-- Categories Badges -->
				{categories.length > 0 && (
					<div class="c7-article-categories">
						{categories.map((c) => (
							<C7Badge label={c.label} pillar={c.slug} href={`/category/${c.slug}`} />
						))}
					</div>
				)}

				<!-- Headline in 7C Display Typography -->
				<h1 class="article-title" {...entry.edit.title}>
					{entry.data.title}
				</h1>

				<!-- Editorial Metadata & Social Share Strip -->
				<div class="c7-article-meta-bar">
					<div class="c7-meta-left">
						{formattedDate && (
							<div class="c7-meta-item">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
								<time datetime={entry.data.publishedAt ? new Date(entry.data.publishedAt).toISOString() : ""}>
									{formattedDate}
								</time>
							</div>
						)}
						<div class="c7-meta-item">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
							<span>{readingTimeMin} menit baca</span>
						</div>
						<div class="c7-meta-item c7-meta-author">
							<span class="c7-author-dot" aria-hidden="true"></span>
							<a href={authorProfile.archiveUrl} class="c7-meta-author-link">{authorName}</a>
						</div>
					</div>

					<!-- Social Share Group -->
					<div class="c7-share-group" aria-label="Bagikan artikel ini">
						<span class="c7-share-label">Bagikan:</span>
						<button type="button" class="c7-share-btn c7-copy-btn" id="c7-copy-link-btn" title="Salin tautan artikel" aria-label="Salin tautan artikel">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
							<span id="c7-copy-status">Salin</span>
						</button>
						<a
							href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="c7-share-btn"
							title="Bagikan ke X"
							aria-label="Bagikan ke X"
						>
							<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</a>
						<a
							href={`https://api.whatsapp.com/send?text=${encodeURIComponent(entry.data.title + " " + Astro.url.href)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="c7-share-btn"
							title="Bagikan ke WhatsApp"
							aria-label="Bagikan ke WhatsApp"
						>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
						</a>
					</div>
				</div>

				<!-- Featured Image Hero (with 7C Branded Fallback) -->
				<figure class="article-featured-image" {...(entry.data.featured_image ? entry.edit.featured_image : {})}>
					{entry.data.featured_image ? (
						<Image image={entry.data.featured_image} />
					) : (
						<img
							src={heroImage.url}
							alt={heroImage.alt}
							width="1200"
							height="675"
							loading="eager"
							decoding="async"
							class="c7-featured-fallback-img"
						/>
					)}
					{entry.data.featured_image?.alt && (
						<figcaption>{entry.data.featured_image.alt}</figcaption>
					)}
				</figure>

				<!-- Article Body Content (7C Editorial Prose Typography) -->
				<div class="article-content c7-prose prose" {...entry.edit.content}>
					<C7PortableText value={entry.data.content} />
				</div>

				<!-- Topic Tags Cloud -->
				{tags.length > 0 && (
					<div class="c7-article-tags">
						<span class="c7-tags-label">Topik Terkait:</span>
						<div class="c7-tags-list">
							{tags.map((t) => (
								<a href={`/tag/${t.slug}`} class="c7-tag-pill">
									#{t.label}
								</a>
							))}
						</div>
					</div>
				)}

				<!-- Author Profile Card (7C Editorial Byline) -->
				<C7AuthorCard author={authorProfile} locale="id" />

				<!-- Related Posts Section (Liputan Terkait) -->
				{relatedPosts.length > 0 && (
					<section class="c7-related-section" aria-label="Rekomendasi Liputan Terkait">
						<div class="c7-related-header">
							<span class="c7-pulse-indicator" aria-hidden="true"></span>
							<h3 class="c7-related-title">BACA JUGA: LIPUTAN TERKAIT</h3>
						</div>
						<div class="c7-related-grid">
							{relatedPosts.map((p) => {
								const pSlug = p.data?.slug || p.id;
								const pCat = p.data?.terms?.category?.[0]?.label || "Berita";
								const pThumb = p.data?.featured_image?.url || p.data?.featured_image?.src || (typeof p.data?.featured_image === "string" ? p.data?.featured_image : null);
								return (
									<C7PostCard
										title={p.data?.title || ""}
										slug={pSlug}
										category={pCat}
										publishedAt={p.data?.publishedAt}
										thumbnail={pThumb}
									/>
								);
							})}
						</div>
					</section>
				)}
			</article>
		) : (
			<article class="single-page">
				<h1 class="article-title" {...entry.edit.title}>
					{entry.data.title}
				</h1>
				<div class="article-content c7-prose prose" {...entry.edit.content}>
					<C7PortableText value={entry.data.content} />
				</div>
			</article>
		)}

		<!-- Proper 7C Editorial Sidebar -->
		<C7PostSidebar
			currentSlug={slug}
			categorySlug={categories[0]?.slug}
			tags={tags}
			locale="id"
		/>
	</div>

	<!-- Scroll-driven Reading Progress Bar & Social Copy Script -->
	<script is:inline>
		// Reading progress handler
		function updateReadingProgress() {
			const scrollEl = document.body.scrollHeight > document.body.clientHeight ? document.body : document.documentElement;
			const winScroll = scrollEl.scrollTop;
			const height = scrollEl.scrollHeight - scrollEl.clientHeight;
			const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
			const bar = document.getElementById("reading-progress-bar");
			if (bar) bar.style.width = scrolled + "%";
		}
		window.addEventListener("scroll", updateReadingProgress, { passive: true });
		document.body?.addEventListener("scroll", updateReadingProgress, { passive: true });

		// Copy link button handler
		const copyBtn = document.getElementById("c7-copy-link-btn");
		const copyStatus = document.getElementById("c7-copy-status");
		if (copyBtn && copyStatus) {
			copyBtn.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					const prev = copyStatus.textContent;
					copyStatus.textContent = "Disalin!";
					copyBtn.style.color = "var(--7c-sys-primary)";
					setTimeout(() => {
						copyStatus.textContent = prev;
						copyBtn.style.color = "";
					}, 2000);
				} catch (err) {
					console.error("Gagal menyalin tautan:", err);
				}
			});
		}

		// Automatically register this post as read in localStorage
		try {
			const slug = window.location.pathname.replace(/^\/|\/$/g, "");
			if (slug) {
				const raw = localStorage.getItem("c7_read_articles");
				const list = raw ? JSON.parse(raw) : [];
				const set = new Set(Array.isArray(list) ? list : []);
				if (!set.has(slug)) {
					set.add(slug);
					localStorage.setItem("c7_read_articles", JSON.stringify(Array.from(set)));
				}
			}
		} catch (e) {}
	</script>
</Base>

<style>
	/* Breadcrumbs */
	.c7-breadcrumb {
		font-size: 0.8125rem;
		color: var(--7c-sys-on-surface-variant);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.25rem;
	}

	.c7-breadcrumb-link {
		color: var(--7c-sys-on-surface-variant);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.c7-breadcrumb-link:hover {
		color: var(--7c-sys-primary);
	}

	.c7-breadcrumb-sep {
		opacity: 0.45;
		flex-shrink: 0;
	}

	.c7-breadcrumb-current {
		color: var(--7c-sys-on-surface);
		font-weight: 600;
		max-width: 320px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.c7-article-categories {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	/* Metadata and Share Bar */
	.c7-article-meta-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding-bottom: 1.25rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--7c-sys-surface-container-highest, rgba(0, 0, 0, 0.06));
		font-size: 0.875rem;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-meta-left {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.c7-meta-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.c7-meta-author {
		font-weight: 600;
		color: var(--7c-sys-on-surface);
	}

	.c7-author-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--7c-sys-primary);
	}

	/* Social Share Group */
	.c7-share-group {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.c7-share-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--7c-sys-on-surface-variant);
		margin-right: 0.2rem;
	}

	.c7-share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		font-family: var(--7c-font-sans);
		font-size: 0.78rem;
		font-weight: 600;
		border-radius: 9999px;
		border: none;
		background: var(--7c-sys-surface-container-high);
		color: var(--7c-sys-on-surface);
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.c7-share-btn:hover {
		background: var(--7c-sys-surface-container-highest);
		color: var(--7c-sys-primary);
		transform: translateY(-1px);
	}

	/* Topic Tags */
	.c7-article-tags {
		margin-top: 3.25rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--7c-sys-surface-container-highest, rgba(0, 0, 0, 0.06));
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.c7-tags-label {
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.c7-tag-pill {
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		background: var(--7c-sys-surface-container-high);
		border: none;
		color: var(--7c-sys-on-surface);
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.c7-tag-pill:hover {
		color: var(--7c-sys-primary);
		background: var(--7c-sys-surface-container-highest);
		transform: translateY(-1px);
	}

	.c7-author-header-link {
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.c7-author-header-link:hover {
		color: var(--7c-sys-primary);
		text-decoration: underline;
	}

	/* Related Posts Section */
	.c7-related-section {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--7c-sys-surface-container-highest, rgba(0, 0, 0, 0.06));
	}

	.c7-related-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.75rem;
	}

	.c7-related-title {
		font-family: var(--7c-font-display);
		font-size: 1.15rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--7c-sys-on-surface);
		margin: 0;
	}

	.c7-pulse-indicator {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--7c-sys-primary);
	}

	.c7-related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.c7-related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
