---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { resolve7cLegacyUrl } from "../lib/7c-url-guardian";
import { C7_CANONICAL_ORIGIN } from "../lib/7c-seo";
import { get7cRelatedPosts } from "../lib/7c-cms";
import C7ArticleView from "../components/views/C7ArticleView.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

let isPost = true;
let { entry, cacheHint } = await getEmDashEntry("posts", slug, { locale: "id" });

if (!entry) {
	isPost = false;
	const pageResult = await getEmDashEntry("pages", slug, { locale: "id" });
	entry = pageResult.entry;
	cacheHint = pageResult.cacheHint;
}

if (!entry) {
	const legacyMatch = resolve7cLegacyUrl(Astro.url.pathname, Astro.url.searchParams);
	if (legacyMatch) {
		return Astro.redirect(legacyMatch.destination, legacyMatch.status);
	}
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: C7_CANONICAL_ORIGIN,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultDescription: (typeof entry.data.excerpt === "string" && entry.data.excerpt.trim())
		? entry.data.excerpt.trim()
		: `${entry.data.title} — Liputan mendalam, perspektif segar kultur pop, teknologi, dan musik di Tujuhcahaya.`,
});

const categories = entry.data.terms?.category ?? [];
const { posts: relatedPosts } = isPost
	? await get7cRelatedPosts(categories[0]?.slug, slug, 3, "id")
	: { posts: [] };
---

<C7ArticleView
	entry={entry}
	slug={slug}
	locale="id"
	relatedPosts={relatedPosts}
	collection={isPost ? "posts" : "pages"}
	seo={{
		title: seo.title,
		pageTitle: seo.ogTitle,
		description: seo.description,
		canonical: seo.canonical,
	}}
	image={seo.ogImage}
/>
