---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import { build7cDispatchPreview } from "../../lib/7c-dispatch";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 25,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	if (cacheHint) Astro.cache.set(cacheHint);
}

const formattedPosts = posts.map((post) => {
	const formattedDate = post.data.publishedAt
		? new Date(post.data.publishedAt).toLocaleDateString("id-ID", {
				day: "numeric",
				month: "short",
		  })
		: "";
	const cat = { label: term.label, slug: term.slug };
	return {
		post,
		category: cat,
		formattedDate,
		slug: post.data?.slug || post.id,
		preview: build7cDispatchPreview(post, cat, "id"),
	};
});
---

<Base
	title={`Kategori: ${term.label} — Arsip Liputan`}
	description={`Kumpulan liputan, artikel, dan berita seputar ${term.label} di Tujuhcahaya.`}
>
	<div class="dispatch-archive-page">
		<!-- Header of Archive Dispatch Table -->
		<div class="dispatch-header">
			<div class="dispatch-header-left">
				<span class="dispatch-pulse-dot" aria-hidden="true"></span>
				<h1 class="dispatch-header-title">ARSIP LIPUTAN — {term.label.toUpperCase()}</h1>
				<span class="dispatch-count-badge">Kategori</span>
			</div>

			<!-- Quick Category Filter Pills -->
			<div class="dispatch-category-filters" role="navigation" aria-label="Filter Kategori">
				<a href="/posts" class="dispatch-filter-tab">Semua</a>
				<a href="/category/game" class={`dispatch-filter-tab ${term.slug === "game" ? "active" : ""}`}>Game</a>
				<a href="/category/tech" class={`dispatch-filter-tab ${term.slug === "tech" ? "active" : ""}`}>Tech</a>
				<a href="/category/berita" class={`dispatch-filter-tab ${term.slug === "berita" ? "active" : ""}`}>Berita</a>
				<a href="/category/musik" class={`dispatch-filter-tab ${term.slug === "musik" ? "active" : ""}`}>Musik</a>
				<a href="/category/budaya" class={`dispatch-filter-tab ${term.slug === "budaya" ? "active" : ""}`}>Budaya</a>
				<a href="/category/kesehatan" class={`dispatch-filter-tab ${term.slug === "kesehatan" ? "active" : ""}`}>Kesehatan</a>
			</div>
		</div>

		<!-- Dispatch Table Rows -->
		<div class="dispatch-table" role="feed" aria-label={`Daftar Liputan Kategori ${term.label}`}>
			{formattedPosts.length === 0 ? (
				<div class="dispatch-empty-state">
					<p>Belum ada artikel dalam kategori ini.</p>
				</div>
			) : (
				formattedPosts.map((item) => (
					<a
						href={`/${item.slug}`}
						class="dispatch-row"
						data-post-slug={item.slug}
						data-astro-reload
						data-dispatch-preview={JSON.stringify(item.preview)}
					>
						<!-- Status Circle (Hollow circle, transforms to check mark when read and persisted in localStorage) -->
						<div class="dispatch-bullet-wrapper" title="Tandai status baca (Klik untuk ubah)">
							<span class="dispatch-bullet" aria-hidden="true"></span>
						</div>

						<!-- Article Title (Truncated) -->
						<span class="dispatch-title" {...item.post.edit.title}>
							{item.post.data.title}
						</span>

						<!-- Category Pill -->
						<span class={`dispatch-cat-pill cat-${item.category.slug || "default"}`}>
							<span class="cat-dot" aria-hidden="true"></span>
							<span>{item.category.label}</span>
						</span>

						<!-- Assignee / Author Pill (Linear [👤 Redaksi ×]) -->
						<span class="dispatch-assignee">
							<span class="assignee-avatar" aria-hidden="true">
								<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
							</span>
							<span class="assignee-name">Redaksi</span>
							<span class="assignee-x" aria-hidden="true">&times;</span>
						</span>

						<!-- Date Field (Right-aligned) -->
						<time class="dispatch-date" datetime={item.post.data.publishedAt?.toISOString() || ""}>
							{item.formattedDate}
						</time>
					</a>
				))
			)}
		</div>

		<!-- Dispatch Bottom Bar with Linear-Style Pagination -->
		<div class="dispatch-footer">
			<div class="dispatch-footer-meta">
				<span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: var(--color-primary);" aria-hidden="true"></span>
				<span>{term.label} • {cursor ? "Arsip Lanjutan" : "Halaman Utama"}</span>
			</div>

			<div class="dispatch-pagination" aria-label={`Navigasi Halaman ${term.label}`}>
				{cursor && (
					<a href={`/category/${term.slug}`} class="dispatch-page-btn">
						<span aria-hidden="true">&larr;</span>
						<span>Halaman Pertama</span>
					</a>
				)}
				{nextCursor && (
					<a
						href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
						class="dispatch-page-btn"
					>
						<span>Halaman Berikutnya</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
				)}
			</div>
		</div>
	</div>
</Base>
