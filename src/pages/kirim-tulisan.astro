---
/**
 * Ruang Kirim Tulisan — Portal Kontribusi Pembaca Tujuhcahaya
 */

import C7SubmissionView from "../components/views/C7SubmissionView.astro";
import { save7cSubmission } from "../lib/7c-submissions.js";
import { send7cSubmissionNotification } from "../lib/7c-notifications.js";

let submissionStatus: "idle" | "success" | "rejected" = "idle";
let feedbackMessage = "";
let submittedData = {
	name: "",
	email: "",
	phone: "",
	category: "opini",
	title: "",
	content: "",
};

if (Astro.request.method === "POST") {
	try {
		const formData = await Astro.request.formData();
		submittedData = {
			name: String(formData.get("name") || "").trim(),
			email: String(formData.get("email") || "").trim(),
			phone: String(formData.get("phone") || "").trim(),
			category: String(formData.get("category") || "opini"),
			title: String(formData.get("title") || "").trim(),
			content: String(formData.get("content") || "").trim(),
		};

		if (!submittedData.name || !submittedData.email || !submittedData.title || !submittedData.content) {
			submissionStatus = "rejected";
			feedbackMessage = "Mohon isi semua kolom bertanda bintang (Nama, Email, Judul, dan Naskah).";
		} else {
			// 1. Save to EmDash ec_submissions table
			const saveResult = await save7cSubmission({
				title: submittedData.title,
				authorName: submittedData.name,
				authorEmail: submittedData.email,
				authorPhone: submittedData.phone,
				category: submittedData.category,
				content: submittedData.content,
				locale: "id",
			});

			// 2. Dispatch instant alert to Telegram & Discord
			await send7cSubmissionNotification({
				title: submittedData.title,
				authorName: submittedData.name,
				authorEmail: submittedData.email,
				authorPhone: submittedData.phone,
				category: submittedData.category,
				content: submittedData.content,
				submissionId: saveResult.id,
				locale: "id",
			});

			submissionStatus = "success";
			feedbackMessage = `Terima kasih, Bung/Non ${submittedData.name}! Naskahmu ("${submittedData.title}") sudah mendarat di meja redaksi Tujuhcahaya. Tim kurasi kami akan membaca dan mengabarimu lewat email (${submittedData.email}) dalam waktu 3–5 hari kerja.`;
		}
	} catch (e) {
		submissionStatus = "rejected";
		feedbackMessage = "Terjadi kendala saat menyimpan naskah. Silakan coba lagi sebentar lagi.";
	}
}
---

<C7SubmissionView
	locale="id"
	submissionStatus={submissionStatus}
	feedbackMessage={feedbackMessage}
	submittedData={submittedData}
/>
