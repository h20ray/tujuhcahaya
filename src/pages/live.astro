---
import Base from "../layouts/Base.astro";
import { use7cTranslation } from "../i18n/utils";
import { C7LivePlayer } from "../components/live/C7LivePlayer";

const locale = "id";
const { t } = use7cTranslation(locale);
const canonicalUrl = "https://www.tujuhcahaya.com/live";

const radioStationJsonLd = {
	"@context": "https://schema.org",
	"@type": "RadioStation",
	"name": "7Stream",
	"url": canonicalUrl,
	"description": t.live.meta_description,
	"broadcastDisplayName": "Tujuhcahaya Radio",
	"inLanguage": "id"
};
---

<Base
	title={t.live.meta_title}
	description={t.live.meta_description}
	canonical={canonicalUrl}
>
	<script type="application/ld+json" set:html={JSON.stringify(radioStationJsonLd)} />
	<C7LivePlayer client:load t={t.live} />
</Base>
