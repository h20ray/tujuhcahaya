---
/**
 * Pitch a Story — Global Editorial Submissions
 *
 * Tujuhcahaya accepts pitches and essays on tech culture, video game critiques,
 * and socio-digital observations from across Southeast Asia and the globe.
 */

import Base from "../../layouts/Base.astro";
import { save7cSubmission } from "../../lib/7c-submissions.js";
import { send7cSubmissionNotification } from "../../lib/7c-notifications.js";

let submissionStatus: "idle" | "success" | "rejected" = "idle";
let feedbackMessages: string[] = [];
let submittedData = {
	name: "",
	email: "",
	phone: "",
	category: "tech",
	title: "",
	content: "",
};

if (Astro.request.method === "POST") {
	try {
		const formData = await Astro.request.formData();
		submittedData = {
			name: String(formData.get("name") || "").trim(),
			email: String(formData.get("email") || "").trim(),
			phone: String(formData.get("phone") || "").trim(),
			category: String(formData.get("category") || "tech"),
			title: String(formData.get("title") || "").trim(),
			content: String(formData.get("content") || "").trim(),
		};

		if (!submittedData.name || !submittedData.email || !submittedData.title || !submittedData.content) {
			submissionStatus = "rejected";
			feedbackMessages = ["Please fill in all required fields (Name, Email, Title, and Manuscript/Pitch)."];
		} else {
			// 1. Save to EmDash ec_submissions table
			const saveResult = await save7cSubmission({
				title: submittedData.title,
				authorName: submittedData.name,
				authorEmail: submittedData.email,
				authorPhone: submittedData.phone,
				category: submittedData.category,
				content: submittedData.content,
				locale: "en",
			});

			// 2. Dispatch instant alert to Telegram & Discord
			await send7cSubmissionNotification({
				title: submittedData.title,
				authorName: submittedData.name,
				authorEmail: submittedData.email,
				authorPhone: submittedData.phone,
				category: submittedData.category,
				content: submittedData.content,
				submissionId: saveResult.id,
				locale: "en",
			});

			submissionStatus = "success";
			feedbackMessages = [
				`Thank you, ${submittedData.name}! Your pitch "${submittedData.title}" has been received by our editorial desk. Our editors will review your piece and get back to you via email (${submittedData.email}) within 3–5 business days.`,
			];
		}
	} catch (e) {
		submissionStatus = "rejected";
		feedbackMessages = ["An error occurred while processing your submission. Please try again later."];
	}
}
---

<Base
	title="Pitch a Story — Tujuhcahaya"
	description="Submit your critical tech essays, investigative gaming reports, or digital culture observations to Tujuhcahaya."
>
	<div class="c7-submission-container">
		<!-- Simple Header -->
		<header class="c7-submission-header">
			<span class="c7-header-kicker">CONTRIBUTOR DESK</span>
			<h1 class="c7-header-title">Pitch a Story to Tujuhcahaya</h1>
			<p class="c7-header-desc">
				We are always looking for insightful essays, tech criticism, and distinct perspectives on digital culture (typically 800 to 1,500 words).
			</p>
		</header>

		<!-- Feedback Messages -->
		{submissionStatus === "success" && (
			<div class="c7-alert success c7-hairline-box" role="status">
				<h3 class="alert-title">Pitch Received</h3>
				<p>{feedbackMessages[0]}</p>
			</div>
		)}

		{submissionStatus === "rejected" && (
			<div class="c7-alert error c7-hairline-box" role="alert">
				<p>{feedbackMessages[0]}</p>
			</div>
		)}

		<!-- Simple Form -->
		{submissionStatus !== "success" && (
			<form method="POST" class="c7-submission-form c7-hairline-box">
				<div class="form-grid">
					<div class="form-group">
						<label for="name" class="form-label">Full Name / Byline <span class="required">*</span></label>
						<input type="text" id="name" name="name" required value={submittedData.name} class="c7-input" placeholder="Your name" />
					</div>

					<div class="form-group">
						<label for="email" class="form-label">Contact Email <span class="required">*</span></label>
						<input type="email" id="email" name="email" required value={submittedData.email} class="c7-input" placeholder="you@example.com" />
					</div>
				</div>

				<div class="form-grid">
					<div class="form-group">
						<label for="category" class="form-label">Editorial Category <span class="required">*</span></label>
						<select id="category" name="category" class="c7-input">
							<option value="tech" selected={submittedData.category === "tech"}>Tech & Infrastructure</option>
							<option value="game" selected={submittedData.category === "game"}>Gaming Culture</option>
							<option value="culture" selected={submittedData.category === "culture"}>Culture & Criticism</option>
						</select>
					</div>

					<div class="form-group">
						<label for="phone" class="form-label">Signal / WhatsApp <span class="optional">(optional)</span></label>
						<input type="text" id="phone" name="phone" value={submittedData.phone} class="c7-input" placeholder="+1..." />
					</div>
				</div>

				<div class="form-group">
					<label for="title" class="form-label">Working Title <span class="required">*</span></label>
					<input type="text" id="title" name="title" required value={submittedData.title} class="c7-input" placeholder="A sharp, compelling title" />
				</div>

				<div class="form-group">
					<label for="content" class="form-label">Manuscript or Detailed Pitch <span class="required">*</span></label>
					<textarea id="content" name="content" required rows="12" class="c7-input c7-textarea" placeholder="Paste your draft or pitch here...">{submittedData.content}</textarea>
				</div>

				<div class="form-actions">
					<button type="submit" class="c7-submit-btn c7-hairline-box">
						Submit Pitch &rarr;
					</button>
				</div>
			</form>
		)}
	</div>
</Base>

<style>
	.c7-submission-container {
		max-width: 680px;
		margin: 0 auto;
		padding: 2.5rem 1rem 5rem 1rem;
	}

	.c7-submission-header {
		margin-bottom: 2rem;
		text-align: center;
	}

	.c7-header-kicker {
		font-family: var(--7c-sys-font-mono, monospace);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--7c-sys-primary, #0f172a);
		display: block;
		margin-bottom: 0.5rem;
	}

	.c7-header-title {
		font-size: 1.85rem;
		font-weight: 600;
		color: var(--7c-sys-on-surface, #0f172a);
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem 0;
		line-height: 1.25;
	}

	.c7-header-desc {
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--7c-sys-on-surface-variant, #475569);
		margin: 0;
	}

	.c7-submission-form {
		padding: 1.75rem;
		background: var(--7c-sys-surface-container, #ffffff);
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	@media (max-width: 600px) {
		.form-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	.form-group {
		margin-bottom: 1.25rem;
	}

	.form-label {
		display: block;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--7c-sys-on-surface, #1e293b);
		margin-bottom: 0.45rem;
	}

	.required {
		color: #dc2626;
	}

	.c7-input {
		width: 100%;
		padding: 0.75rem 0.9rem;
		font-family: inherit;
		font-size: 0.9375rem;
		background: var(--7c-sys-surface-container-high, #f8fafc);
		border: 1px solid var(--7c-sys-outline-variant, #cbd5e1);
		border-radius: 4px;
		color: var(--7c-sys-on-surface, #0f172a);
		transition: border-color 0.15s ease;
		box-sizing: border-box;
	}

	.c7-input:focus {
		outline: none;
		border-color: var(--7c-sys-primary, #0f172a);
		background: #ffffff;
	}

	.c7-textarea {
		line-height: 1.6;
		resize: vertical;
	}

	.form-actions {
		display: flex;
		justify-content: flex-end;
		margin-top: 1.5rem;
	}

	.c7-submit-btn {
		padding: 0.85rem 1.85rem;
		background: var(--7c-sys-primary, #0f172a);
		color: var(--7c-sys-on-primary, #ffffff);
		font-weight: 600;
		font-size: 0.9375rem;
		cursor: pointer;
		transition: opacity 0.15s ease;
		border: none;
	}

	.c7-submit-btn:hover {
		opacity: 0.92;
	}

	.c7-alert {
		padding: 1.25rem 1.5rem;
		margin-bottom: 1.75rem;
	}

	.c7-alert.success {
		background: #f0fdf4;
		border-left: 4px solid #16a34a;
		color: #14532d;
	}

	.c7-alert.error {
		background: #fef2f2;
		border-left: 4px solid #dc2626;
		color: #7f1d1d;
	}

	.alert-title {
		font-size: 1rem;
		font-weight: 600;
		margin: 0 0 0.35rem 0;
	}
</style>
