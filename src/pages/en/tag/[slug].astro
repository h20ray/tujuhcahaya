---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import C7ArchiveView from "../../../components/views/C7ArchiveView.astro";
import { resolve7cAuthor, format7cCompactDate } from "../../../lib/7c-cms";
import type { C7PostData } from "../../../lib/7c-cms";
import { build7cDispatchPreview } from "../../../lib/7c-dispatch";
import { use7cTranslation } from "../../../i18n/utils";

const locale = "en";
const { t } = use7cTranslation(locale);
const slug = decodeSlug(Astro.params.slug);

const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 25,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	if (cacheHint) Astro.cache.set(cacheHint);
}

// Batched category lookup for posts in this tag
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);

const formattedPosts = posts.map((post) => {
	const cats = categoriesByEntry.get(post.data.id) ?? [];
	const firstCategory = cats[0] ?? { label: "News", slug: "berita" };
	const formattedDate = format7cCompactDate(post.data.publishedAt, locale);
	const postData = (post.data as unknown) as C7PostData;
	const authorProfile = resolve7cAuthor(
		postData.byline || postData.primaryBylineId || postData.primary_byline_id || null,
		locale,
	);
	const postSlug = post.data?.slug || post.id;
	return {
		slug: postSlug,
		title: post.data.title,
		category: firstCategory,
		formattedDate,
		publishedAt: post.data.publishedAt,
		author: authorProfile,
		preview: build7cDispatchPreview(post, firstCategory, locale),
		editTitle: post.edit?.title,
	};
});
---

<C7ArchiveView
	locale={locale}
	pageTitle={`Topic: #${term.label} — ${t.topbar.dispatch_live}`}
	pageDescription={`Curated stories and investigative dispatches tagged #${term.label} on Tujuhcahaya.`}
	headerTitle={`${t.topbar.dispatch_live} — #${term.label.toUpperCase()}`}
	headerBadge="Topic Tag"
	posts={formattedPosts}
	nextCursor={nextCursor}
	tagFilter={term.slug}
/>
