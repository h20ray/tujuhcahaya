---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import C7Badge from "../../components/ui/C7Badge.astro";
import C7PostCard from "../../components/editorial/C7PostCard.astro";
import C7PostSidebar from "../../components/editorial/C7PostSidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { use7cTranslation } from "../../i18n/utils";
import {
	calc7cReadingTime,
	format7cDate,
	get7cRelatedPosts,
	resolve7cFeaturedImage,
} from "../../lib/7c-cms";

const locale = "en";
const { t } = use7cTranslation(locale);
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

// 1. Check posts collection first
let isPost = true;
let { entry, cacheHint } = await getEmDashEntry("posts", slug);

// 2. Fallback to pages collection (e.g. /en/about-us)
if (!entry) {
	isPost = false;
	const pageResult = await getEmDashEntry("pages", slug);
	entry = pageResult.entry;
	cacheHint = pageResult.cacheHint;
}

if (!entry) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const tags = entry.data.terms?.tag ?? [];
const categories = entry.data.terms?.category ?? [];
const readingTimeMin = calc7cReadingTime(entry.data.content);
const formattedDate = format7cDate(entry.data.publishedAt, locale);

// Fetch 3 related posts if this is a post
const { posts: relatedPosts } = isPost
	? await get7cRelatedPosts(categories[0]?.slug, slug, 3, locale)
	: { posts: [] };

const heroImage = resolve7cFeaturedImage(entry.data.featured_image, entry.data.title);
const ogImage = seo.ogImage || heroImage.url;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={ogImage}
	content={{ collection: isPost ? "posts" : "pages", id: entry.data.id, slug }}
>
	<!-- Fixed Reading Progress Indicator -->
	<div id="reading-progress-bar" aria-hidden="true"></div>

	<div class="article-container">
		{isPost ? (
			<article class="single-article">
				<!-- Semantic Breadcrumbs -->
				<nav class="c7-breadcrumb" aria-label="Page Breadcrumbs">
					<a href="/en" class="c7-breadcrumb-link">{t.nav.home}</a>
					<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
					{categories.length > 0 ? (
						<>
							<a href={`/en/category/${categories[0].slug}`} class="c7-breadcrumb-link">{categories[0].label}</a>
							<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</>
					) : (
						<>
							<a href="/en/posts" class="c7-breadcrumb-link">{t.nav.archive}</a>
							<svg class="c7-breadcrumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</>
					)}
					<span class="c7-breadcrumb-current" aria-current="page">
						{entry.data.title}
					</span>
				</nav>

				<!-- Categories Badges -->
				{categories.length > 0 && (
					<div class="c7-article-categories">
						{categories.map((c) => (
							<C7Badge label={c.label} pillar={c.slug} href={`/en/category/${c.slug}`} />
						))}
					</div>
				)}

				<!-- Headline -->
				<h1 class="article-title" {...entry.edit?.title}>
					{entry.data.title}
				</h1>

				<!-- Editorial Metadata & Share Bar -->
				<div class="c7-article-meta-bar">
					<div class="c7-meta-left">
						{formattedDate && (
							<div class="c7-meta-item">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
								<time datetime={entry.data.publishedAt ? new Date(entry.data.publishedAt).toISOString() : ""}>
									{formattedDate}
								</time>
							</div>
						)}
						<div class="c7-meta-item">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
							<span>{readingTimeMin} {t.editorial.read_time}</span>
						</div>
						<div class="c7-meta-item c7-meta-author">
							<span class="c7-author-dot" aria-hidden="true"></span>
							<span>Tujuhcahaya Editorial</span>
						</div>
					</div>

					<!-- Social Share -->
					<div class="c7-share-group" aria-label="Share this story">
						<span class="c7-share-label">Share:</span>
						<button type="button" class="c7-share-btn" id="c7-copy-link-btn" title="Copy article link" aria-label="Copy article link">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
							<span id="c7-copy-status">Copy</span>
						</button>
						<a
							href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="c7-share-btn"
							title="Share on X"
							aria-label="Share on X"
						>
							<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</a>
						<a
							href={`https://api.whatsapp.com/send?text=${encodeURIComponent(entry.data.title + " " + Astro.url.href)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="c7-share-btn"
							title="Share on WhatsApp"
							aria-label="Share on WhatsApp"
						>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
						</a>
					</div>
				</div>

				<!-- Featured Image Hero (with 7C Branded Fallback) -->
				<figure class="article-featured-image" {...(entry.data.featured_image ? entry.edit?.featured_image : {})}>
					{entry.data.featured_image ? (
						<Image image={entry.data.featured_image} />
					) : (
						<img
							src={heroImage.url}
							alt={heroImage.alt}
							width="1200"
							height="675"
							loading="eager"
							decoding="async"
							class="c7-featured-fallback-img"
						/>
					)}
					{entry.data.featured_image?.alt && (
						<figcaption>{entry.data.featured_image.alt}</figcaption>
					)}
				</figure>

				<!-- Editorial Prose Content -->
				<div class="article-body c7-prose prose" {...entry.edit?.content}>
					<PortableText value={entry.data.content} />
				</div>

				<!-- Tags Cloud -->
				{tags.length > 0 && (
					<div class="c7-article-tags">
						<span class="c7-tags-label">Related Topics:</span>
						<div class="c7-tags-list">
							{tags.map((tag) => (
								<a href={`/en/tag/${tag.slug}`} class="c7-tag-pill">
									#{tag.label}
								</a>
							))}
						</div>
					</div>
				)}

				<!-- Editorial Card -->
				<div class="c7-redaksi-card">
					<div class="c7-redaksi-avatar" aria-hidden="true">7C</div>
					<div class="c7-redaksi-content">
						<div class="c7-redaksi-title">Tujuhcahaya Editorial Newsroom</div>
						<p class="c7-redaksi-desc">
							Independent digital media house exploring investigative journalism, cutting-edge tech, gaming culture, and contemporary social dynamics with uncompromising editorial standards.
						</p>
						<div class="c7-redaksi-meta-links">
							<a href="/en/about-us">About Us</a>
							<span class="sep" aria-hidden="true">&bull;</span>
							<a href="/en/redaksi">Masthead</a>
							<span class="sep" aria-hidden="true">&bull;</span>
							<a href="/en/privacy-policy">Privacy Policy</a>
						</div>
					</div>
				</div>

				<!-- Related Posts Section -->
				{relatedPosts.length > 0 && (
					<section class="c7-related-section" aria-label="Related Dispatches">
						<div class="c7-related-header">
							<span class="c7-pulse-indicator" aria-hidden="true"></span>
							<h3 class="c7-related-title">READ NEXT: RELATED DISPATCHES</h3>
						</div>
						<div class="c7-related-grid">
							{relatedPosts.map((p) => {
								const pSlug = p.data?.slug || p.id;
								const pCat = p.data?.terms?.category?.[0]?.label || "News";
								const pThumb = p.data?.featured_image?.url || p.data?.featured_image?.src || (typeof p.data?.featured_image === "string" ? p.data?.featured_image : null);
								return (
									<C7PostCard
										title={p.data?.title || ""}
										slug={`en/${pSlug}`}
										category={pCat}
										publishedAt={p.data?.publishedAt}
										thumbnail={pThumb}
									/>
								);
							})}
						</div>
					</section>
				)}
			</article>
		) : (
			<article class="single-page">
				<h1 class="article-title" {...entry.edit?.title}>
					{entry.data.title}
				</h1>
				<div class="article-body c7-prose prose" {...entry.edit?.content}>
					<PortableText value={entry.data.content} />
				</div>
			</article>
		)}

		<!-- Proper 7C Editorial Sidebar -->
		<C7PostSidebar
			currentSlug={slug}
			categorySlug={categories[0]?.slug}
			tags={tags}
			locale="en"
		/>
	</div>

	<!-- Scroll-driven Reading Progress Bar & Social Copy Script -->
	<script is:inline>
		window.addEventListener("scroll", () => {
			const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
			const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
			const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
			const bar = document.getElementById("reading-progress-bar");
			if (bar) bar.style.width = scrolled + "%";
		});

		const copyBtn = document.getElementById("c7-copy-link-btn");
		const copyStatus = document.getElementById("c7-copy-status");
		if (copyBtn && copyStatus) {
			copyBtn.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					const prev = copyStatus.textContent;
					copyStatus.textContent = "Copied!";
					copyBtn.style.color = "var(--7c-sys-primary)";
					setTimeout(() => {
						copyStatus.textContent = prev;
						copyBtn.style.color = "";
					}, 2000);
				} catch (err) {
					console.error("Failed to copy link:", err);
				}
			});
		}
	</script>
</Base>

<style>
	/* Breadcrumbs */
	.c7-breadcrumb {
		font-size: 0.8125rem;
		color: var(--7c-sys-on-surface-variant);
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 1.25rem;
		overflow-x: auto;
		white-space: nowrap;
	}

	.c7-breadcrumb-link {
		color: var(--7c-sys-on-surface-variant);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.c7-breadcrumb-link:hover {
		color: var(--7c-sys-primary);
	}

	.c7-breadcrumb-sep {
		opacity: 0.45;
		flex-shrink: 0;
	}

	.c7-breadcrumb-current {
		color: var(--7c-sys-on-surface);
		font-weight: 600;
		max-width: 320px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.c7-article-categories {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	/* Metadata and Share Bar */
	.c7-article-meta-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
		margin-bottom: 1.75rem;
		border-bottom: 1px solid var(--7c-sys-outline-variant);
		font-size: 0.875rem;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-meta-left {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.c7-meta-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.c7-meta-author {
		font-weight: 600;
		color: var(--7c-sys-on-surface);
	}

	.c7-author-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--7c-sys-primary);
	}

	/* Social Share Group */
	.c7-share-group {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.c7-share-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--7c-sys-on-surface-variant);
		margin-right: 0.2rem;
	}

	.c7-share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.55rem;
		font-family: var(--7c-font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		border-radius: var(--7c-radius-sm);
		border: 1px solid var(--7c-sys-outline-variant);
		background: var(--7c-sys-surface-container-high);
		color: var(--7c-sys-on-surface);
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.c7-share-btn:hover {
		background: var(--7c-sys-surface-container-highest);
		border-color: var(--7c-sys-primary);
		color: var(--7c-sys-primary);
		transform: translateY(-1px);
	}

	/* Topic Tags */
	.c7-article-tags {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--7c-sys-outline-variant);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.c7-tags-label {
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.c7-tag-pill {
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.25rem 0.6rem;
		border-radius: 9999px;
		background: var(--7c-sys-surface-container-high);
		border: 1px solid var(--7c-sys-outline-variant);
		color: var(--7c-sys-on-surface);
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.c7-tag-pill:hover {
		color: var(--7c-sys-primary);
		border-color: var(--7c-sys-primary);
		background: var(--7c-sys-surface-container-lowest);
	}

	/* Redaksi Card */
	.c7-redaksi-card {
		margin-top: 2.5rem;
		padding: 1.5rem;
		background: var(--7c-sys-surface-container-high);
		border: 1px solid var(--7c-sys-outline-variant);
		border-left: 4px solid var(--7c-sys-primary);
		border-radius: var(--7c-radius-md);
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.c7-redaksi-avatar {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--7c-sys-primary);
		color: var(--7c-sys-on-primary);
		font-family: var(--7c-font-display);
		font-weight: 800;
		font-size: 1.05rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.c7-redaksi-content {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.c7-redaksi-title {
		font-family: var(--7c-font-display);
		font-size: 1rem;
		font-weight: 800;
		color: var(--7c-sys-on-surface);
	}

	.c7-redaksi-desc {
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--7c-sys-on-surface-variant);
		margin: 0;
	}

	.c7-redaksi-meta-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		margin-top: 0.35rem;
		flex-wrap: wrap;
	}

	.c7-redaksi-meta-links a {
		color: var(--7c-sys-primary);
		text-decoration: none;
		font-weight: 600;
	}

	.c7-redaksi-meta-links a:hover {
		text-decoration: underline;
	}

	.c7-redaksi-meta-links .sep {
		color: var(--7c-sys-outline);
	}

	/* Related Posts Section */
	.c7-related-section {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--7c-sys-outline-variant);
	}

	.c7-related-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}

	.c7-related-title {
		font-family: var(--7c-font-display);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.015em;
		color: var(--7c-sys-on-surface);
		margin: 0;
	}

	.c7-pulse-indicator {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--7c-sys-primary);
	}

	.c7-related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.c7-related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
