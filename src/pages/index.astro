---
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import C7IsometricStack from "../components/ui/C7IsometricStack.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { build7cDispatchPreview, resolve7cArticleSource } from "../lib/7c-dispatch";

// Fetch recent 25 posts for the compact hero dispatch list (auto-fits via smart fill)
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 25,
});

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

// Single batched query for categories across hero posts
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);

const heroNewsList = posts.map((post) => {
	const cats = categoriesByEntry.get(post.data.id) ?? [];
	const firstCategory = cats[0] ?? { label: "Berita", slug: "berita" };
	const slug = post.data?.slug || post.id;
	const source = resolve7cArticleSource(post);
	return {
		post,
		slug,
		category: firstCategory,
		source,
		preview: build7cDispatchPreview(post, firstCategory, "id"),
	};
});
---

<Base title={siteTitle} description={siteTagline} isHome={true}>
	<!-- HERO SECTION: Option B Hybrid (Left: Linear-Style Dispatch Table | Right: Isometric 3D Stack) -->
	<section class="hero-split" data-active-tab="dispatch" aria-label="Profil & Sorotan Tujuhcahaya">
		<!-- Mobile Segmented View Switcher (< 992px) -->
		<div class="c7-hero-mobile-tabs" role="tablist" aria-label="Pilihan Tampilan Sorotan Tujuhcahaya">
			<button
				type="button"
				role="tab"
				id="hero-tab-dispatch"
				class="c7-hero-tab-btn is-active"
				aria-selected="true"
				aria-controls="hero-left-pane"
				data-hero-tab="dispatch"
			>
				<span class="c7-tab-icon" aria-hidden="true">⚡</span>
				<span class="c7-tab-label">Liputan Terkini</span>
				<span class="c7-tab-count">16k</span>
			</button>
			<button
				type="button"
				role="tab"
				id="hero-tab-stack"
				class="c7-hero-tab-btn"
				aria-selected="false"
				aria-controls="hero-right-pane"
				data-hero-tab="stack"
			>
				<span class="c7-tab-icon" aria-hidden="true">⬡</span>
				<span class="c7-tab-label">7 Rubrik Studio</span>
			</button>
		</div>

		<!-- Left Column: Linear-Style Editorial Dispatch Table -->
		<div class="hero-left-pane" id="hero-left-pane" role="tabpanel" aria-labelledby="hero-tab-dispatch">
			<h1 class="sr-only">Tujuhcahaya — Media House &amp; Creative Studio</h1>

			<!-- Header Bar of Dispatch Table -->
			<div class="dispatch-header">
				<div class="dispatch-header-left">
					<span class="dispatch-header-title">LIPUTAN TERKINI</span>
				</div>
				<span class="dispatch-count-badge">16k+ Artikel</span>
			</div>

			<!-- Dispatch Table Rows (Compact: Bullet + Title + Hover Arrow) -->
			<div class="dispatch-table" role="feed" aria-label="Daftar Liputan Terkini">
				{heroNewsList.map((item) => (
					<a
						href={`/${item.slug}`}
						class="dispatch-row dispatch-row-compact"
						data-post-slug={item.slug}
						data-astro-reload
						data-dispatch-preview={JSON.stringify(item.preview)}
					>
						<!-- Status Circle (Hollow circle, transforms to check mark when read and persisted in localStorage) -->
						<div class="dispatch-bullet-wrapper" title="Tandai status baca (Klik untuk ubah)">
							<span class="dispatch-bullet" aria-hidden="true"></span>
						</div>

						<!-- Article Title -->
						<span class="dispatch-title" {...item.post.edit.title}>
							{item.post.data.title}
						</span>

						<!-- Source Pill (7C Red for Tujuhcahaya, or external source) -->
						<span
							class={`c7-source-pill ${item.source.is7c ? "c7-source-pill-7c" : "c7-source-pill-external"}`}
							title={`Sumber: ${item.source.name}`}
						>
							{item.source.label}
						</span>
					</a>
				))}
			</div>

			<!-- Dispatch Bottom Bar -->
			<div class="dispatch-footer">
				<div class="dispatch-footer-meta">
					<span>Media House &amp; Creative Studio</span>
				</div>
				<a href="/posts" class="dispatch-footer-cta">
					<span>Arsip Lengkap</span>
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>
		</div>

		<!-- Right Column: Isometric 3D Layered Stack of the 7 Rubrik with 7C Perspective Grid Background -->
		<div class="hero-right-pane" id="hero-right-pane" role="tabpanel" aria-labelledby="hero-tab-stack">
			<!-- Ambient Radial Glow -->
			<div class="hero-right-glow" aria-hidden="true"></div>

			<!-- Animated 2:1 Dimetric Perspective Wireframe Grid Floor -->
			<div class="hero-iso-grid-bg" aria-hidden="true">
				<svg viewBox="0 0 1000 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-iso-grid-svg">
					<path
						d="M36 232L536 482M71 214L571 464M107 196L607 446M143 179L643 429M179 161L679 411M214 143L714 393M250 125L750 375M286 107L786 357M321 89L821 339M357 71L857 321M393 54L893 304M429 36L929 286M464 18L964 268M536 18L36 268M571 36L71 286M607 54L107 304M643 71L143 321M679 89L179 339M714 107L214 357M750 125L250 375M786 143L286 393M821 161L321 411M857 179L357 429M893 196L393 446M929 214L429 464M964 232L464 482M500 0L1000 250L500 500L0 250Z"
						stroke="currentColor"
						stroke-width="0.75"
						class="iso-grid-path"
					></path>
				</svg>
			</div>

			<!-- 3D Isometric Stack Foreground -->
			<div class="hero-right-foreground">
				<C7IsometricStack />
			</div>
		</div>
	</section>

	<!-- Hairline Metrics Bar (7C Bespoke Hairline Architecture) -->
	<section class="metrics-bar" aria-label="Statistik Tujuhcahaya">
		<div class="metric-item">
			<span class="metric-value">16k+</span>
			<span class="metric-label">Artikel Terbit</span>
		</div>
		<div class="metric-item">
			<span class="metric-value">7 Rubrik</span>
			<span class="metric-label">Fokus Liputan</span>
		</div>
		<div class="metric-item">
			<span class="metric-value">Independen</span>
			<span class="metric-label">Media &amp; Studio</span>
		</div>
		<div class="metric-item">
			<span class="metric-value">Kultur Pop</span>
			<span class="metric-label">Perspektif Segar</span>
		</div>
	</section>
	<script src="../scripts/7c-dispatch-smart-fill.ts"></script>
</Base>
