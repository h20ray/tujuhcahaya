---
import Base from "../layouts/Base.astro";
---

<Base title="Halaman Tidak Ditemukan (404)">
	<div style="text-align: center; padding: 5rem 1rem; max-width: 600px; margin: 0 auto;">
		<span style="font-size: 5rem; font-weight: 900; color: var(--color-primary); line-height: 1; display: block; margin-bottom: 1rem;">
			404
		</span>
		<h1 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem; color: var(--color-text);">
			Halaman Tidak Ditemukan
		</h1>
		<p style="color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.6;">
			Maaf, artikel atau halaman yang Anda cari mungkin telah dipindahkan, dihapus, atau alamat URL yang Anda masukkan keliru.
		</p>
		<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
			<a href="/" class="btn-primary">
				&larr; Kembali ke Beranda
			</a>
			<a href="/posts" class="btn-outline">
				Jelajahi Arsip Artikel &rarr;
			</a>
		</div>
	</div>
</Base>
