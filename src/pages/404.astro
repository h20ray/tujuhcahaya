---
import Base from "../layouts/Base.astro";
import { resolve7cLegacyUrl } from "../lib/7c-url-guardian";

const legacyMatch = resolve7cLegacyUrl(Astro.url.pathname, Astro.url.searchParams);
if (legacyMatch) {
	return Astro.redirect(legacyMatch.destination, legacyMatch.status);
}
---

<Base title="Halaman Tidak Ditemukan (404)">
	<div style="text-align: center; padding: 5rem 1rem; max-width: 600px; margin: 0 auto;">
		<span style="font-size: 5rem; font-weight: 700; color: var(--7c-sys-primary); line-height: 1; display: block; margin-bottom: 1rem;">
			404
		</span>
		<h1 style="font-size: 1.85rem; font-weight: 600; margin-bottom: 1rem; color: var(--7c-sys-on-surface);">
			Halaman Tidak Ditemukan
		</h1>
		<p style="color: var(--7c-sys-on-surface-variant); font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.6;">
			Maaf, artikel atau halaman yang Anda cari mungkin telah dipindahkan, dihapus, atau alamat URL yang Anda masukkan keliru.
		</p>
		<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
			<a href="/" class="c7-hairline-box" style="padding: 0.75rem 1.5rem; background-color: var(--7c-sys-primary); color: var(--7c-sys-on-primary); font-weight: 600; text-decoration: none;">
				&larr; Kembali ke Beranda
			</a>
			<a href="/posts" class="c7-hairline-box" style="padding: 0.75rem 1.5rem; background-color: var(--7c-sys-surface-container); color: var(--7c-sys-on-surface); font-weight: 500; text-decoration: none;">
				Jelajahi Arsip Artikel &rarr;
			</a>
		</div>
	</div>
</Base>
