---
import { decodeSlug } from "emdash";
import C7AuthorView from "../../components/views/C7AuthorView.astro";
import { get7cPostsByAuthor, format7cCompactDate } from "../../lib/7c-cms";
import { build7cDispatchPreview } from "../../lib/7c-dispatch";

const locale = "id";
const rawSlug = decodeSlug(Astro.params.slug);
if (!rawSlug) {
	return Astro.redirect("/404");
}

const pageQuery = Number(Astro.url.searchParams.get("page")) || 1;
const page = Math.max(1, pageQuery);
const limit = 25;

const { byline, author, posts, total, totalPages, hasMore } = await get7cPostsByAuthor(
	rawSlug,
	page,
	limit,
	locale
);

// If byline not in database and not a known author
if (!byline && author.isEditorialFallback && rawSlug !== "redaksi") {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const formattedPosts = posts.map((post) => {
	const formattedDate = format7cCompactDate(post.published_at, locale);
	const cat = {
		label: post.category_label || "Berita",
		slug: post.category_slug || "berita",
	};
	return {
		id: post.id,
		slug: post.slug,
		title: post.title,
		formattedDate,
		publishedAt: post.published_at,
		category: cat,
		preview: build7cDispatchPreview(post, cat, locale),
	};
});
---

<C7AuthorView
	locale={locale}
	author={author}
	posts={formattedPosts}
	total={total}
	page={page}
	totalPages={totalPages}
	hasMore={hasMore}
/>
