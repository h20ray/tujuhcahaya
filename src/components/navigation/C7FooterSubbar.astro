---
import { type Locale } from "../../i18n/utils";

interface Props {
	locale?: Locale;
}

const { locale: _locale } = Astro.props;
void _locale;
const currentYear = new Date().getFullYear();
---

<!-- Sub-bar (Copyright & EmDash Credit) -->
<div class="c7-uni-footer-subbar">
	<div class="c7-uni-subbar-inner">
		<div class="c7-uni-subbar-left">
			<span class="c7-uni-copy">&copy; {currentYear} Tujuhcahaya. All Rights Reserved.</span>
		</div>
		<div class="c7-uni-subbar-right">
			<span class="c7-uni-credit">
				Built using <a href="https://emdashcms.com/" target="_blank" rel="noopener noreferrer" class="c7-emdash-link">EmDash</a> with <span class="c7-heart" aria-hidden="true">&#x2764;&#xfe0f;</span>
			</span>
		</div>
	</div>
</div>

<style>
	/* Sub-bar (Copyright & EmDash Credit) */
	.c7-uni-footer-subbar {
		border-top: 1px solid var(--7c-sys-outline-variant);
		padding: 0.85rem 1.75rem;
		font-size: 0.75rem;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-uni-subbar-inner {
		max-width: var(--7c-max-width, 1280px);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.c7-uni-subbar-left {
		display: flex;
		align-items: center;
	}

	.c7-uni-copy {
		font-size: 0.8125rem;
		color: var(--7c-sys-on-surface-variant);
	}

	.c7-uni-subbar-right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	/* Credit */
	.c7-uni-credit {
		font-size: 0.8125rem;
		color: var(--7c-sys-on-surface-variant);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.c7-emdash-link {
		color: var(--7c-sys-on-surface);
		text-decoration: underline;
		text-underline-offset: 2.5px;
		font-weight: 600;
		transition: color 0.15s ease;
	}

	.c7-emdash-link:hover {
		color: var(--7c-sys-primary);
	}

	.c7-heart {
		display: inline-block;
		font-size: 0.85rem;
		line-height: 1;
	}

	/* Responsive Breakpoints */
	@media (max-width: 840px) {
		.c7-uni-footer-subbar {
			padding: 0.85rem 1.25rem;
		}

		.c7-uni-subbar-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.c7-uni-subbar-right {
			width: 100%;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
	}
</style>
