---
import {
	type Locale,
	DEFAULT_LOCALE,
	use7cTranslation,
	get7cLocalizedPath,
} from "../../i18n/utils";

interface Props {
	currentDateStr: string;
	locale?: Locale;
}

const { currentDateStr, locale = DEFAULT_LOCALE } = Astro.props;
const { t } = use7cTranslation(locale);

const currentPath = Astro.url.pathname;
const idPath = get7cLocalizedPath(currentPath, "id");
const enPath = get7cLocalizedPath(currentPath, "en");
---

<div class="c7-top-bar">
	<div class="c7-top-bar-inner">
		<div class="c7-top-date">
			<span class="c7-pulse-dot" aria-hidden="true"></span>
			<span>{currentDateStr}</span>
			<span class="c7-divider" aria-hidden="true">|</span>
			<span class="c7-brand-label">{t.topbar.brand_tagline}</span>
		</div>

		<div class="c7-top-actions">
			<!-- Minimalist Language Switcher [ ID | EN ] -->
			<nav class="c7-lang-switcher" aria-label={t.topbar.switch_lang}>
				<a
					href={idPath}
					class={`c7-lang-link ${locale === "id" ? "active" : ""}`}
					aria-current={locale === "id" ? "true" : undefined}
				>
					ID
				</a>
				<span class="c7-lang-divider" aria-hidden="true">/</span>
				<a
					href={enPath}
					class={`c7-lang-link ${locale === "en" ? "active" : ""}`}
					aria-current={locale === "en" ? "true" : undefined}
				>
					EN
				</a>
			</nav>

			<!-- Theme Switcher -->
			<button
				id="theme-toggle"
				class="c7-theme-toggle-btn"
				aria-label={locale === "en" ? t.nav.mode_dark : t.nav.mode_dark}
				aria-pressed="false"
			>
				<svg
					class="sun-icon"
					width="13"
					height="13"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<span class="toggle-text">{t.nav.mode}</span>
			</button>
		</div>
	</div>
</div>

<style>
	.c7-top-bar {
		background-color: var(--7c-sys-surface-container-low);
		border-bottom: 1px solid var(--7c-sys-outline-variant);
		font-size: 0.8125rem;
		color: var(--7c-sys-on-surface-variant);
		padding: 6px 0;
	}

	.c7-top-bar-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 1.5rem;
	}

	.c7-top-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 500;
	}

	.c7-pulse-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--7c-sys-primary);
		box-shadow: 0 0 6px var(--7c-sys-primary);
	}

	.c7-divider {
		opacity: 0.3;
		margin: 0 0.25rem;
	}

	.c7-brand-label {
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		font-weight: 700;
		color: var(--7c-sys-primary);
	}

	.c7-top-actions {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.c7-lang-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.c7-lang-link {
		color: var(--7c-sys-on-surface-variant);
		text-decoration: none;
		padding: 0.15rem 0.3rem;
		border-radius: var(--7c-radius-sm);
		transition: all 0.12s ease;
	}

	.c7-lang-link:hover {
		color: var(--7c-sys-primary);
	}

	.c7-lang-link.active {
		color: var(--7c-sys-primary);
		background-color: var(--7c-sys-surface-container-high);
	}

	.c7-lang-divider {
		opacity: 0.3;
	}

	.c7-theme-toggle-btn {
		background: var(--7c-sys-surface-container-high);
		border: 1px solid var(--7c-sys-outline-variant);
		color: var(--7c-sys-on-surface);
		border-radius: var(--7c-radius-sm);
		padding: 3px 9px;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		transition: all 0.15s ease;
	}

	.c7-theme-toggle-btn:hover {
		background: var(--7c-sys-surface-container-highest);
		border-color: var(--7c-sys-primary);
	}
</style>
