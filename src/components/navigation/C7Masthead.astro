---
import LiveSearch from "emdash/ui/search";
import C7Logo from "../ui/C7Logo.astro";
import {
	type Locale,
	DEFAULT_LOCALE,
	use7cTranslation,
	get7cLocalizedPath,
} from "../../i18n/utils";

interface MenuItem {
	url: string;
	label: string;
	target?: string;
}

interface Props {
	currentPath: string;
	currentDateStr?: string;
	locale?: Locale;
	menu?: {
		items: MenuItem[];
	} | null;
}

const { currentPath, currentDateStr, locale = DEFAULT_LOCALE, menu } = Astro.props;
const { t } = use7cTranslation(locale);
const prefix = locale === "en" ? "/en" : "";

const idPath = get7cLocalizedPath(currentPath, "id");
const enPath = get7cLocalizedPath(currentPath, "en");

// Default 7C Editorial Pillars if menu is not set
const defaultItems: MenuItem[] = [
	{ url: `${prefix}/category/berita`, label: locale === "en" ? "News" : "Berita" },
	{ url: `${prefix}/category/tech`, label: "Tech" },
	{ url: `${prefix}/category/game`, label: "Game" },
	{ url: `${prefix}/category/musik`, label: locale === "en" ? "Music" : "Musik" },
	{ url: `${prefix}/category/budaya`, label: locale === "en" ? "Culture" : "Budaya" },
	{ url: `${prefix}/category/kesehatan`, label: locale === "en" ? "Health" : "Kesehatan" },
	{ url: `${prefix}/about-us`, label: t.nav.about },
];

const navItems = (menu?.items && menu.items.length > 0) ? menu.items : defaultItems;
---

<header class="c7-masthead" id="site-masthead">
	<div class="c7-masthead-inner">
		<!-- Left: Brand Identity -->
		<div class="c7-masthead-left">
			<a href="/" class="c7-brand-link" aria-label="Beranda Tujuhcahaya">
				<C7Logo width={26} height={26} color="var(--7c-sys-primary)" ariaHidden={true} />
				<span class="c7-brand-title">Tujuh<span class="c7-brand-accent">cahaya</span></span>
			</a>
		</div>

		<!-- Right: Desktop Search, Nav Links & Utilities (>= 1024px) -->
		<div class="c7-masthead-right">
			<!-- Live Search Trigger Box with ⌘K -->
			<div class="c7-search-box" id="c7-desktop-search-box">
				<svg
					class="c7-search-icon"
					xmlns="http://www.w3.org/2000/svg"
					width="15"
					height="15"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>

				<LiveSearch
					placeholder="Cari liputan..."
					collections={["posts", "pages"]}
					class="c7-live-search"
					inputClass="c7-search-input"
					resultsClass="c7-search-results"
				/>

				<kbd class="c7-search-kbd" title="Shortcut pencarian">⌘K</kbd>
			</div>

			<!-- Desktop Navigation Links -->
			<nav class="c7-nav" aria-label="Navigasi Utama">
				<a
					href="/"
					class={`c7-nav-link ${currentPath === "/" ? "active" : ""}`}
					aria-current={currentPath === "/" ? "page" : undefined}
				>
					Beranda
				</a>
				{
					navItems.map((item) => {
						const isActive =
							currentPath === item.url ||
							(item.url !== "/" && currentPath.startsWith(item.url));
						return (
							<a
								href={item.url}
								class={`c7-nav-link ${isActive ? "active" : ""}`}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={isActive ? "page" : undefined}
							>
								{item.label}
							</a>
						);
					})
				}
				<a
					href={`${prefix}/posts`}
					class={`c7-nav-link ${currentPath.startsWith(`${prefix}/posts`) ? "active" : ""}`}
					aria-current={currentPath.startsWith(`${prefix}/posts`) ? "page" : undefined}
				>
					{t.nav.archive}
				</a>
			</nav>

			<span class="c7-nav-divider" aria-hidden="true"></span>

			<!-- Language Switcher [ ID | EN ] -->
			<div class="c7-lang-switcher" aria-label={t.topbar.switch_lang}>
				<a
					href={idPath}
					class={`c7-lang-btn ${locale === "id" ? "active" : ""}`}
					aria-current={locale === "id" ? "true" : undefined}
				>
					ID
				</a>
				<span class="c7-lang-sep" aria-hidden="true">/</span>
				<a
					href={enPath}
					class={`c7-lang-btn ${locale === "en" ? "active" : ""}`}
					aria-current={locale === "en" ? "true" : undefined}
				>
					EN
				</a>
			</div>

			<!-- Theme Toggle Button -->
			<div class="c7-utility-group">
				<button
					class="c7-btn-icon c7-theme-toggle"
					aria-label={locale === "en" ? t.nav.mode_dark : t.nav.mode_dark}
					type="button"
				>
					<!-- Sun icon (shown in dark mode) -->
					<svg
						class="c7-icon c7-icon-sun"
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>

					<!-- Moon icon (shown in light mode) -->
					<svg
						class="c7-icon c7-icon-moon"
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Header Controls (< 1024px) -->
		<div class="c7-mobile-controls">
			<button
				class="c7-btn-icon c7-theme-toggle"
				aria-label="Ganti mode tema"
				type="button"
			>
				<svg
					class="c7-icon c7-icon-sun"
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<svg
					class="c7-icon c7-icon-moon"
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>

			<button
				id="c7-mobile-menu-toggle"
				class="c7-btn-icon"
				aria-label="Buka menu navigasi"
				aria-expanded="false"
				aria-controls="c7-mobile-drawer"
				type="button"
			>
				<svg
					class="c7-menu-open-icon"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg
					class="c7-menu-close-icon"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					style="display: none;"
				>
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer -->
	<div id="c7-mobile-drawer" class="c7-mobile-drawer" hidden>
		<div class="c7-mobile-drawer-inner">
			<!-- Mobile Search -->
			<div class="c7-mobile-search-box">
				<svg
					class="c7-search-icon"
					xmlns="http://www.w3.org/2000/svg"
					width="15"
					height="15"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<LiveSearch
					placeholder="Cari liputan..."
					collections={["posts", "pages"]}
					class="c7-live-search"
					inputClass="c7-search-input"
					resultsClass="c7-search-results"
				/>
			</div>

			<!-- Mobile Nav List -->
			<nav class="c7-mobile-nav-list" aria-label="Navigasi Mobile">
				<a
					href="/"
					class={`c7-mobile-nav-item ${currentPath === "/" ? "active" : ""}`}
				>
					<span>Beranda</span>
					<span class="c7-mobile-arrow" aria-hidden="true">&rarr;</span>
				</a>
				{
					navItems.map((item) => {
						const isActive =
							currentPath === item.url ||
							(item.url !== "/" && currentPath.startsWith(item.url));
						return (
							<a
								href={item.url}
								class={`c7-mobile-nav-item ${isActive ? "active" : ""}`}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							>
								<span>{item.label}</span>
								<span class="c7-mobile-arrow" aria-hidden="true">&rarr;</span>
							</a>
						);
					})
				}
				<a
					href="/posts"
					class={`c7-mobile-nav-item ${currentPath.startsWith("/posts") ? "active" : ""}`}
				>
					<span>Arsip Liputan</span>
					<span class="c7-mobile-arrow" aria-hidden="true">&rarr;</span>
				</a>
			</nav>

			<!-- Mobile Meta Footer -->
			<div class="c7-mobile-drawer-footer">
				<div class="c7-mobile-meta">
					<span>{currentDateStr ? `${currentDateStr} • TUJUHCAHAYA` : "7C DIGITAL ENGINE • TUJUHCAHAYA"}</span>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	/* ==========================================================================
	   7C Bespoke Full-Width Minimalist Masthead
	   ========================================================================== */
	.c7-masthead {
		width: 100% !important;
		position: sticky;
		top: 0;
		z-index: 200;
		background-color: var(--7c-sys-surface);
		border-bottom: 1px solid var(--7c-sys-outline-variant);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		transition: background-color 0.2s ease, border-color 0.2s ease;
		flex-shrink: 0;
		align-self: stretch;
	}

	:root[data-theme="dark"] .c7-masthead {
		background-color: rgba(5, 6, 8, 0.92);
		border-bottom: 1px solid var(--7c-sys-outline-variant);
	}

	:root:not([data-theme="dark"]) .c7-masthead {
		background-color: rgba(255, 255, 255, 0.94);
		border-bottom: 1px solid var(--7c-sys-outline-variant);
	}

	.c7-masthead-inner {
		width: 100%;
		max-width: 100%;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.25rem;
		gap: 1rem;
		margin: 0;
	}

	@media (min-width: 768px) {
		.c7-masthead-inner {
			padding: 0 2rem;
			height: 60px;
		}
	}

	@media (min-width: 1280px) {
		.c7-masthead-inner {
			padding: 0 3rem;
		}
	}

	/* Left: Brand Identity */
	.c7-masthead-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.c7-brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--7c-sys-on-surface);
	}

	.c7-brand-title {
		font-family: var(--7c-font-display);
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.025em;
		text-transform: uppercase;
		color: var(--7c-sys-on-surface);
		line-height: 1;
	}

	.c7-brand-accent {
		color: var(--7c-sys-primary);
	}

	/* Right: Desktop Controls */
	.c7-masthead-right {
		display: none;
		align-items: center;
		gap: 0.75rem;
	}

	@media (min-width: 1024px) {
		.c7-masthead-right {
			display: flex;
		}
	}

	/* Search Box (Vengeance Minimalist Pill) */
	.c7-search-box {
		position: relative;
		display: flex;
		align-items: center;
		width: 230px;
		height: 34px;
		border: 1px solid var(--7c-sys-outline-variant);
		background-color: var(--7c-sys-surface-container-low);
		transition: border-color 0.15s ease, background-color 0.15s ease;
		border-radius: 0;
	}

	.c7-search-box:focus-within {
		border-color: var(--7c-sys-primary);
		background-color: var(--7c-sys-surface-container);
	}

	.c7-search-icon {
		position: absolute;
		left: 10px;
		color: var(--7c-sys-on-surface-variant);
		pointer-events: none;
		z-index: 2;
		opacity: 0.75;
	}

	.c7-search-kbd {
		position: absolute;
		right: 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 19px;
		padding: 0 5px;
		font-family: var(--7c-font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		color: var(--7c-sys-on-surface-variant);
		background-color: var(--7c-sys-surface-container);
		border: 1px solid var(--7c-sys-outline-variant);
		pointer-events: none;
		border-radius: 0;
		line-height: 1;
	}

	/* Style EmDash LiveSearch within our pill */
	:global(.c7-live-search) {
		width: 100% !important;
		height: 100% !important;
		display: flex !important;
		align-items: center !important;
	}

	:global(.c7-search-input) {
		width: 100% !important;
		height: 32px !important;
		padding: 0 42px 0 32px !important;
		border: none !important;
		background: transparent !important;
		font-size: 0.8125rem !important;
		color: var(--7c-sys-on-surface) !important;
		outline: none !important;
		border-radius: 0 !important;
		font-family: inherit !important;
	}

	:global(.c7-search-input::placeholder) {
		color: var(--7c-sys-on-surface-variant);
		opacity: 0.7;
	}

	:global(.c7-search-results) {
		position: absolute !important;
		top: calc(100% + 4px) !important;
		right: 0 !important;
		width: 320px !important;
		max-width: 90vw !important;
		background-color: var(--7c-sys-surface-container) !important;
		border: 1px solid var(--7c-sys-outline-variant) !important;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25) !important;
		border-radius: 0 !important;
		z-index: 300 !important;
	}

	/* Desktop Navigation Links */
	.c7-nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.c7-nav-link {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.6rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--7c-sys-on-surface-variant);
		text-decoration: none;
		border-radius: 0;
		transition: color 0.15s ease, background-color 0.15s ease;
		white-space: nowrap;
	}

	.c7-nav-link:hover {
		color: var(--7c-sys-on-surface);
		background-color: var(--7c-sys-surface-container-high);
	}

	.c7-nav-link.active {
		color: var(--7c-sys-primary);
		font-weight: 600;
	}

	.c7-nav-divider {
		width: 1px;
		height: 18px;
		background-color: var(--7c-sys-outline-variant);
		margin: 0 0.35rem;
	}

	.c7-lang-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.c7-lang-btn {
		color: var(--7c-sys-on-surface-variant);
		text-decoration: none;
		padding: 0.2rem 0.4rem;
		border-radius: var(--7c-radius-sm);
		transition: all 0.12s ease;
		line-height: 1;
	}

	.c7-lang-btn:hover {
		color: var(--7c-sys-primary);
	}

	.c7-lang-btn.active {
		color: var(--7c-sys-primary);
		background-color: var(--7c-sys-surface-container-high);
	}

	.c7-lang-sep {
		opacity: 0.35;
		font-size: 0.7rem;
	}

	/* Icon Buttons (Theme toggle, mobile hamburger) */
	.c7-btn-icon {
		width: 34px;
		height: 34px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--7c-sys-outline-variant);
		background-color: transparent;
		color: var(--7c-sys-on-surface);
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
		border-radius: 0;
		padding: 0;
	}

	.c7-btn-icon:hover {
		background-color: var(--7c-sys-surface-container-high);
		border-color: var(--7c-sys-primary);
		color: var(--7c-sys-primary);
	}

	/* Theme Toggle Icons (Dual Sun/Moon) */
	:root[data-theme="dark"] .c7-icon-sun {
		display: block;
	}
	:root[data-theme="dark"] .c7-icon-moon {
		display: none;
	}
	:root:not([data-theme="dark"]) .c7-icon-sun {
		display: none;
	}
	:root:not([data-theme="dark"]) .c7-icon-moon {
		display: block;
	}

	/* Mobile Controls (< 1024px) */
	.c7-mobile-controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	@media (min-width: 1024px) {
		.c7-mobile-controls {
			display: none;
		}
	}

	/* Mobile Navigation Drawer */
	.c7-mobile-drawer {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		background-color: var(--7c-sys-surface);
		border-bottom: 1px solid var(--7c-sys-outline-variant);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
		z-index: 190;
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	:root[data-theme="dark"] .c7-mobile-drawer {
		background-color: rgba(5, 6, 8, 0.97);
	}

	:root:not([data-theme="dark"]) .c7-mobile-drawer {
		background-color: rgba(255, 255, 255, 0.98);
	}

	.c7-mobile-drawer-inner {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.c7-mobile-search-box {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		height: 38px;
		border: 1px solid var(--7c-sys-outline-variant);
		background-color: var(--7c-sys-surface-container-low);
		border-radius: 0;
