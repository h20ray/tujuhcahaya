---
/**
 * C7SpecTable — Technical Specification Table
 *
 * Structured comparison table for hardware, smartphones, gaming consoles,
 * and PC components. Styled with 7C Hairline Grid and MD3X contrast roles.
 */

interface SpecItem {
	label: string;
	value: string;
	highlight?: boolean;
}

interface Props {
	title?: string;
	specs: SpecItem[];
	source?: string;
	class?: string;
}

const {
	title = "Spesifikasi Teknis",
	specs = [],
	source = "Data lab redaksi Tujuhcahaya",
	class: className = "",
} = Astro.props;
---

<div class={`c7-spec-table-wrapper c7-hairline-box ${className}`} role="region" aria-label={title}>
	<div class="c7-spec-header">
		<span class="c7-spec-dot" aria-hidden="true"></span>
		<h4 class="c7-spec-title">{title}</h4>
	</div>

	<table class="c7-spec-table">
		<tbody>
			{specs.map((item) => (
				<tr class={item.highlight ? "highlight-row" : ""}>
					<th scope="row" class="spec-label">{item.label}</th>
					<td class="spec-value">{item.value}</td>
				</tr>
			))}
		</tbody>
	</table>

	{source && (
		<div class="c7-spec-footer">
			<span>Sumber: {source}</span>
		</div>
	)}
</div>

<style>
	.c7-spec-table-wrapper {
		margin: 2.5rem 0;
		background: var(--7c-sys-surface-container, #ffffff);
		border-radius: 16px;
		border: none;
		box-shadow: var(--7c-sys-elevation-1);
		overflow: hidden;
	}


	.c7-spec-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.25rem;
		background: var(--7c-sys-surface-container-high, #f8fafc);
		border-bottom: 1px solid var(--7c-sys-outline-variant, #e2e8f0);
	}

	.c7-spec-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--7c-sys-primary, #0f172a);
	}

	.c7-spec-title {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 800;
		color: var(--7c-sys-on-surface, #0f172a);
		letter-spacing: -0.01em;
	}

	.c7-spec-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.c7-spec-table th,
	.c7-spec-table td {
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--7c-sys-outline-variant, #f1f5f9);
		vertical-align: top;
		text-align: left;
	}

	.c7-spec-table tr:last-child th,
	.c7-spec-table tr:last-child td {
		border-bottom: none;
	}

	.spec-label {
		width: 32%;
		font-weight: 700;
		color: var(--7c-sys-on-surface-variant, #64748b);
		background: var(--7c-sys-surface-container-low, #fcfcfc);
	}

	.spec-value {
		color: var(--7c-sys-on-surface, #1e293b);
		line-height: 1.5;
	}

	.highlight-row {
		background-color: var(--7c-sys-surface-container-high, #f8fafc);
	}

	.highlight-row .spec-value {
		font-weight: 700;
		color: var(--7c-sys-primary, #0f172a);
	}

	.c7-spec-footer {
		padding: 0.5rem 1.25rem;
		background: var(--7c-sys-surface-container-low, #f8fafc);
		border-top: 1px solid var(--7c-sys-outline-variant, #f1f5f9);
		font-size: 0.75rem;
		color: var(--7c-sys-on-surface-variant, #94a3b8);
		font-family: var(--7c-sys-font-mono, monospace);
	}

	@media (max-width: 640px) {
		.spec-label {
			width: 40%;
			font-size: 0.8125rem;
		}
	}
</style>
