---
/**
 * C7SidebarNewsletter — 7C newsletter callout
 */
import type { Locale } from "../../../i18n/utils";

interface Props {
	locale?: Locale;
}

const { locale = "id" } = Astro.props;
const isEn = locale === "en";
---

<section class="c7-sidebar-card c7-sidebar-newsletter" aria-label={isEn ? "Newsletter" : "Buletin Redaksi"}>
	<div class="c7-newsletter-badge">{isEn ? "Newsletter" : "Buletin Redaksi"}</div>
	<h3 class="c7-newsletter-title">
		{isEn ? "Weekly Curated Journalism" : "Jurnalisme Terkurasi Setiap Pekan"}
	</h3>
	<p class="c7-newsletter-desc">
		{isEn
			? "Independent investigations, tech deep-dives, and modern culture directly in your inbox."
			: "Investigasi independen, analisis mendalam teknologi, dan kultur pop langsung ke surel Anda."}
	</p>
	<form class="c7-newsletter-form" action="#">
		<input
			type="email"
			required
			placeholder={isEn ? "name@email.com" : "nama@email.com"}
			class="c7-newsletter-input"
			aria-label={isEn ? "Email address" : "Alamat email"}
		/>
		<button type="submit" class="c7-newsletter-btn">
			{isEn ? "Subscribe" : "Langganan"}
		</button>
	</form>
</section>

<style>
	.c7-sidebar-card {
		background: var(--7c-sys-surface-container-low);
		border: none;
		border-radius: 20px;
		padding: 1.5rem;
		box-shadow: var(--7c-sys-elevation-1);
		transition: background-color 0.2s ease, box-shadow 0.25s cubic-bezier(0.2, 0, 0, 1), transform 0.25s cubic-bezier(0.2, 0, 0, 1);
	}

	.c7-sidebar-card:hover {
		background: var(--7c-sys-surface-container);
		box-shadow: var(--7c-sys-elevation-2);
		transform: translateY(-2px);
	}

	.c7-sidebar-newsletter {
		border: none;
		border-radius: 20px;
		background: var(--7c-sys-surface-container-low);
	}

	.c7-newsletter-badge {
		font-family: var(--7c-font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--7c-sys-primary);
		margin-bottom: 0.4rem;
	}

	.c7-newsletter-title {
		font-family: var(--7c-font-display);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--7c-sys-on-surface);
		margin-bottom: 0.4rem;
	}

	.c7-newsletter-desc {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--7c-sys-on-surface-variant);
		margin-bottom: 0.85rem;
	}

	.c7-newsletter-form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.c7-newsletter-input {
		width: 100%;
		padding: 0.65rem 0.85rem;
		font-size: 0.82rem;
		background: var(--7c-sys-surface-container-high);
		border: none;
		border-radius: 9999px;
		color: var(--7c-sys-on-surface);
		box-shadow: var(--7c-sys-elevation-0);
		transition: box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1), background-color 0.2s ease;
	}

	.c7-newsletter-input:focus {
		outline: none;
		background: var(--7c-sys-surface-container-lowest);
		box-shadow: 0 0 0 3px rgba(213, 0, 0, 0.12), var(--7c-sys-elevation-2);
	}

	:global([data-theme="dark"]) .c7-newsletter-input:focus {
		background: var(--7c-sys-surface-container-low);
		box-shadow: 0 0 0 3px rgba(255, 82, 82, 0.18), var(--7c-sys-elevation-2);
	}

	.c7-newsletter-btn {
		width: 100%;
		padding: 0.65rem;
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--7c-sys-on-primary);
		background: var(--7c-sys-primary);
		border: none;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.15s ease, box-shadow 0.15s ease;
	}

	.c7-newsletter-btn:hover {
		background: var(--7c-sys-primary-hover);
	}

	.c7-newsletter-btn:focus-visible {
		outline: none;
		box-shadow: var(--7c-sys-focus-ring);
	}
</style>
