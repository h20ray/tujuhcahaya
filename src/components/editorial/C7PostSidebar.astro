---
/**
 * C7PostSidebar — Tujuhcahaya Editorial Sidebar
 * MD3X Tonal Surfaces + 7C 1px Hairline Architecture
 */
import C7SidebarStaticCard from "./sidebar/C7SidebarStaticCard.astro";
import C7SidebarSearch from "./sidebar/C7SidebarSearch.astro";
import C7SidebarTrending from "./sidebar/C7SidebarTrending.astro";
import C7SidebarPillars from "./sidebar/C7SidebarPillars.astro";
import C7SidebarNewsletter from "./sidebar/C7SidebarNewsletter.astro";
import C7SidebarTopics from "./sidebar/C7SidebarTopics.astro";
import type { Locale } from "../../i18n/utils";

interface Props {
	currentSlug?: string;
	categorySlug?: string;
	tags?: Array<{ id?: string; label: string; slug: string }>;
	locale?: Locale;
	class?: string;
	isStaticPage?: boolean;
}

const {
	currentSlug,
	categorySlug,
	tags = [],
	locale = "id",
	class: className = "",
	isStaticPage = false,
} = Astro.props;

const isEn = locale === "en";
---

<aside class={`c7-sidebar ${className}`} aria-label={isEn ? "Article Sidebar" : "Bilah Sisi Artikel"}>
	{isStaticPage && <C7SidebarStaticCard currentSlug={currentSlug} locale={locale} />}

	<C7SidebarSearch locale={locale} />

	<C7SidebarTrending currentSlug={currentSlug} locale={locale} />

	<C7SidebarPillars categorySlug={categorySlug} locale={locale} />

	<C7SidebarNewsletter locale={locale} />

	<C7SidebarTopics tags={tags} locale={locale} />

	<slot />
</aside>

<style>
	.c7-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: sticky;
		top: 5.5rem;
		align-self: start;
	}

	@media (max-width: 992px) {
		.c7-sidebar {
			position: static;
			margin-top: 2rem;
		}
	}
</style>
