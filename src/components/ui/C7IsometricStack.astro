---
// Tujuhcahaya - Isometric 3D Layered Architecture Stack ("Cake" Engine)
// 7C Digital Engine with 2:1 dimetric projection and bespoke spring kinematics

const pillars = [
	{
		key: "lab",
		num: "01",
		generic: "Pilar 01 • Studio & Hub",
		name: "Tujuhcahaya Media Lab",
		shortLeft: "LAB",
		shortRight: "CREATIVE STUDIO & LAB",
		desc: "Pusat eksplorasi media independen, riset konten kreatif, dan fondasi arsitektur digital Tujuhcahaya.",
		accent: "#64748b",
		stroke: "#475569",
		count: "Studio & Hub",
		url: "/about-us",
		y: 276,
	},
	{
		key: "kesehatan",
		num: "02",
		generic: "Pilar 02 • Gaya Hidup",
		name: "Kesehatan & Kebugaran",
		shortLeft: "SEHAT",
		shortRight: "GAYA HIDUP & SAINS",
		desc: "Informasi medis terpercaya, wawasan kebugaran fisik dan mental, serta tren hidup sehat tanpa menggurui.",
		accent: "#14b8a6",
		stroke: "#0d9488",
		count: "606 Liputan Terbit",
		url: "/category/kesehatan",
		y: 230,
	},
	{
		key: "budaya",
		num: "03",
		generic: "Pilar 03 • Seni & Kultur",
		name: "Seni & Budaya Pop",
		shortLeft: "BUDAYA",
		shortRight: "KULTUR & NARASI",
		desc: "Eksplorasi fenomena urban, warisan budaya lokal, seni visual, dan dinamika sosial masyarakat modern.",
		accent: "#f59e0b",
		stroke: "#d97706",
		count: "233 Liputan Terbit",
		url: "/category/budaya",
		y: 184,
	},
	{
		key: "musik",
		num: "04",
		generic: "Pilar 04 • Audio & Hiburan",
		name: "Musik & Nada",
		shortLeft: "MUSIK",
		shortRight: "AUDIO & HIBURAN",
		desc: "Kurasi rilisan musik terkini, ulasan album, profil musisi independen dan arus utama, serta tren audio global.",
		accent: "#8b5cf6",
		stroke: "#7c3aed",
		count: "3.576 Liputan Terbit",
		url: "/category/musik",
		y: 138,
	},
	{
		key: "tech",
		num: "05",
		generic: "Pilar 05 • Masa Depan",
		name: "Teknologi & Inovasi",
		shortLeft: "TECH",
		shortRight: "INOVASI & GADGET",
		desc: "Kecerdasan buatan, perangkat keras mutakhir, terobosan software, dan perkembangan ekosistem digital dunia.",
		accent: "#0284c7",
		stroke: "#0369a1",
		count: "3.729 Liputan Terbit",
		url: "/category/tech",
		y: 92,
	},
	{
		key: "game",
		num: "06",
		generic: "Pilar 06 • Interaktif",
		name: "Video Game & Esports",
		shortLeft: "GAME",
		shortRight: "ESPORTS & INDUSTRI",
		desc: "Review game konsol dan PC, perkembangan industri game global, strategi esports, dan komunitas gamer.",
		accent: "#10b981",
		stroke: "#059669",
		count: "4.282 Liputan Terbit",
		url: "/category/game",
		y: 46,
	},
	{
		key: "berita",
		num: "07",
		generic: "Pilar 07 • Jurnalisme",
		name: "Berita & Newsroom",
		shortLeft: "BERITA",
		shortRight: "JURNALISME AKTUAL",
		desc: "Laporan berita terhangat, isu kebijakan esensial, peristiwa sosial, dan investigasi mendalam berintegritas.",
		accent: "#e11d48",
		stroke: "#be123c",
		count: "4.265 Liputan Terbit",
		url: "/category/berita",
		y: 0,
	},
];
---

<div class="c7-stack-widget">
	<div class="cake enter has-out" id="cakeContainer">
		<svg
			viewBox="-287 -35 574 610"
			class="cake-svg"
			aria-label="Tujuh Lapis Cahaya Tujuhcahaya Media — klik lapisan mana saja untuk memisahkan"
		>
			<defs>
				<!-- 7C Reusable Dimetric 2:1 Slab Geometry Template -->
				<g id="cake-slab-template">
					<!-- Top Face: 380px wide diamond (Rhombus, 2:1 slope) -->
					<path class="f-top" d="M0 0 L190 95 L0 190 L-190 95 Z" />
					<!-- Left Face: 40px vertical extrusion -->
					<path class="f-left" d="M-190 95 L0 190 L0 230 L-190 135 Z" />
					<!-- Right Face: 40px vertical extrusion -->
					<path class="f-right" d="M0 190 L190 95 L190 135 L0 230 Z" />
				</g>
			</defs>

			<!-- 7 Layers in Painter's Order wrapped in dynamic balance assembly -->
			<g class="cake-assembly">
			{pillars.map((p, index) => {
				const isDefault = p.key === "game"; // Default selected layer
				return (
					<g
						class={`layer ${isDefault ? "sel out" : ""}`}
						data-key={p.key}
						role="button"
						tabindex="0"
						aria-pressed={isDefault ? "true" : "false"}
						aria-label={`${p.name} (Lapis ${p.num})`}
						style={`transform: translate(0px, ${p.y}px); --layer-accent: ${p.accent}; --layer-stroke: ${p.stroke};`}
					>
						<g class="drop" style={`animation-delay: ${0.05 + index * 0.08}s`}>
							<g class="slide">
								<use href="#cake-slab-template" />

								<!-- Left Face Label (Affine Isometric Matrix, slope 0.5) -->
								<text
									class="lab lab-l"
									text-anchor="middle"
									dominant-baseline="central"
									transform="matrix(0.894, 0.447, 0, 1, -95, 164)"
								>
									{p.shortLeft}
								</text>

								<!-- Right Face Label (Affine Isometric Matrix, slope -0.5) -->
								<text
									class="lab lab-r"
									text-anchor="middle"
									dominant-baseline="central"
									transform="matrix(0.894, -0.447, 0, 1, 95, 164)"
								>
									{p.shortRight}
								</text>

								<!-- Top Layer Graphic (Official Tujuhcahaya Logo mapped to top diamond) -->
								{p.key === "berita" && (
									<g transform="matrix(1, 0.5, -1, 0.5, 0, 95)" class="top-logo-group">
										<g transform="scale(0.0065) translate(-7937.5, -7937.5)">
											<path
												class="top-logo-path"
												d="M13209.56 2093.57c60.25-170.71 42.67-323.83-52.72-459.4-95.4-135.56-233.46-203.34-414.21-203.34H9820.58L5106.13 14956.64c-70.29 180.74-60.26 341.41 30.12 481.99 90.37 140.57 230.96 210.87 421.74 210.87h2907z"
												style="fill-rule:nonzero"
											/>
											<path
												class="top-logo-path"
												d="M4988.18 225.5c1302.14 0 2357.73 1055.59 2357.73 2357.73 0 1302.15-1055.59 2357.73-2357.73 2357.73S2630.45 3885.38 2630.45 2583.23c0-1302.14 1055.59-2357.73 2357.73-2357.73"
											/>
										</g>
									</g>
								)}
							</g>
						</g>
					</g>
				);
			})}
			</g>
		</svg>
	</div>

	<!-- 7C Bespoke Synchronized Editorial Detail Panel -->
	<div class="cake-detail" id="cakeDetail" aria-live="polite">
		<div class="cd-header">
			<span class="cd-generic" id="cdGeneric">Pilar 06 • Interaktif</span>
			<span class="cd-badge" id="cdCount">4.282 Liputan Terbit</span>
		</div>
		<h3 class="cd-name" id="cdName">Video Game &amp; Esports</h3>
		<p class="cd-desc" id="cdDesc">
			Review game konsol dan PC, perkembangan industri game global, strategi esports, dan komunitas gamer.
		</p>
		<div class="cd-links">
			<a href="/category/game" id="cdLink" class="cd-action-link">
				<span>Jelajahi Liputan Kategori Ini</span>
				<span class="arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</div>

<style>
	.c7-stack-widget {
		width: 100%;
		max-width: 520px;
		display: flex;
		flex-direction: column;
		align-items: center;
		user-select: none;
	}

	.cake {
		width: 100%;
		display: flex;
		justify-content: center;
		position: relative;
	}

	.cake-svg {
		width: 100%;
		height: auto;
		max-height: 480px;
		display: block;
		overflow: visible;
		animation: iso-breathe 7s ease-in-out infinite;
		will-change: transform;
		transform-origin: center center;
	}

	@keyframes iso-breathe {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cake-svg {
			animation: none !important;
			transform: none !important;
		}
		.cake-assembly,
		.layer .slide {
			transition: none !important;
		}
	}

	.layer {
		cursor: pointer;
		outline: none;
	}

	/* Face Styling with Dimetric Directional Lighting */
	.f-top {
		fill: var(--color-card, #ffffff);
		stroke: var(--color-border, #d0d5db);
		stroke-width: 1;
		transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.2s ease, filter 0.2s ease;
	}

	.f-left {
		fill: var(--color-card-subtle, #f3f5f6);
		stroke: var(--color-border, #d0d5db);
		stroke-width: 1;
		transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.2s ease, filter 0.2s ease;
	}

	.f-right {
		fill: var(--color-bg, #fbfcfd);
		stroke: var(--color-border, #d0d5db);
		stroke-width: 1;
		transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.2s ease, filter 0.2s ease;
	}

	/* Dark Mode Faces */
	:global([data-theme="dark"]) .f-top {
		fill: #0d1017;
		stroke: rgba(255, 255, 255, 0.12);
	}
	:global([data-theme="dark"]) .f-left {
		fill: #06080c;
		stroke: rgba(255, 255, 255, 0.1);
	}
	:global([data-theme="dark"]) .f-right {
		fill: #11151e;
		stroke: rgba(255, 255, 255, 0.12);
	}

	/* Layer Hover & Focus Illumination (Stable Lighting Feedback, Zero Boundary Jitter) */
	.layer:hover .f-top,
	.layer:focus-visible .f-top {
		filter: brightness(1.08);
		stroke: var(--layer-stroke, var(--color-primary));
		stroke-width: 1.5;
	}

	.layer:hover .f-left,
	.layer:hover .f-right {
		filter: brightness(1.05);
	}

	:global([data-theme="dark"]) .layer:hover .f-top,
	:global([data-theme="dark"]) .layer:focus-visible .f-top {
		filter: brightness(1.22);
		stroke: var(--layer-accent, var(--color-primary));
		stroke-width: 1.5;
	}

	:global([data-theme="dark"]) .layer:hover .f-left,
	:global([data-theme="dark"]) .layer:hover .f-right {
		filter: brightness(1.15);
	}

	/* Selected & Active States */
	.layer.sel .f-top {
		fill: var(--layer-accent, #e11d48);
		stroke: var(--layer-stroke, #be123c);
	}

	.layer:focus-visible .f-top {
		stroke: var(--color-primary);
		stroke-width: 2.5;
	}
	.layer:focus-visible .f-left,
	.layer:focus-visible .f-right {
		stroke: var(--color-primary);
		stroke-width: 2;
	}

	/* Top Face Logo Graphic (Tujuhcahaya Vector Emblem) */
	.top-logo-path {
		fill: var(--color-primary, #d50000);
		transition: fill 0.25s ease;
	}

	:global([data-theme="dark"]) .top-logo-path {
		fill: #ffffff;
	}

	/* When top layer is selected, its face turns crimson red, so logo turns pure white */
	.layer.sel .top-logo-path {
		fill: #ffffff !important;
	}

	/* Typography on Isometric Faces (WCAG AAA Contrast Compliant) */
	.lab {
		font-family: var(--font-display, "Plus Jakarta Sans", system-ui, sans-serif);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 1.5px;
		user-select: none;
		pointer-events: none;
	}

	.lab-l {
		fill: #334155; /* Slate 700: 9.2:1 contrast against #f3f5f6 (WCAG AAA) */
	}

	:global([data-theme="dark"]) .lab-l {
		fill: #e2e8f0; /* Slate 200: 14.5:1 contrast against #06080c (WCAG AAA) */
	}

	.lab-r {
		fill: #0f172a; /* Slate 900: 16.5:1 contrast against #fbfcfd (WCAG AAA) */
	}

	:global([data-theme="dark"]) .lab-r {
		fill: #f8fafc; /* 18.5:1 contrast against #11151e (WCAG AAA) */
	}

	.layer.sel .lab-r {
		font-weight: 800;
	}

	/* Dynamic Visual Weight Counterbalance */
	.cake-assembly {
		transition: transform 560ms cubic-bezier(0.3, 1.18, 0.4, 1);
		will-change: transform;
	}

	.cake.has-out .cake-assembly {
		transform: translateX(-70px);
	}

	/* 7C Bespoke Spring Kinematics */
	.layer .slide {
		transition: transform 560ms cubic-bezier(0.3, 1.18, 0.4, 1);
	}

	/* Sliced-Out State (Spring physics along 2:1 slope vector) */
	.layer.out .slide,
	.layer.out:hover .slide,
	.layer.out:focus-visible .slide {
		transform: translate(140px, 70px);
	}

	/* Page-load Cascade Stagger Entrance */
	@keyframes cakein {
		0% {
			opacity: 0;
			transform: translate(140px, -70px);
		}
		100% {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes cakehint {
		0%, 100% {
			transform: none;
		}
		45% {
			transform: translate(40px, 20px);
		}
	}

	.cake.enter g.layer .drop {
		animation: cakein 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.layer.hint .slide {
		animation: cakehint 1s cubic-bezier(0.45, 0, 0.3, 1) both;
	}

	/* 7C Bespoke Editorial Detail Panel (Sharp Hairline Architecture) */
	.cake-detail {
		margin-top: 1rem;
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: 0;
		padding: 1.15rem 1.35rem;
		background: var(--color-card);
		transition: opacity 160ms ease, transform 160ms ease;
		min-height: 145px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	:global([data-theme="dark"]) .cake-detail {
		background: #0f1218;
		border-color: rgba(255, 255, 255, 0.1);
	}

	.cake-detail.swap {
		opacity: 0;
		transform: translateY(6px);
	}

	.cd-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.35rem;
	}

	.cd-generic {
		font-family: var(--font-display, "Plus Jakarta Sans", system-ui, sans-serif);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.cd-badge {
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--color-primary);
		background: var(--color-card-subtle);
		padding: 0.15rem 0.5rem;
		border-radius: 0;
		border: 1px solid var(--color-border);
	}

	:global([data-theme="dark"]) .cd-badge {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.1);
	}

	.cd-name {
		font-family: var(--font-display, "Plus Jakarta Sans", system-ui, sans-serif);
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin: 0.25rem 0 0.45rem;
	}

	.cd-desc {
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin-bottom: 0.85rem;
	}

	.cd-action-link {
		font-family: var(--font-display, "Plus Jakarta Sans", system-ui, sans-serif);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: transform 0.15s ease;
	}

	.cd-action-link:hover {
		transform: translateX(3px);
	}

	.cd-action-link .arrow {
		font-size: 1.05rem;
	}

	@media (max-width: 991px) {
		.cake-svg {
			max-height: min(250px, 34vh);
		}

		.cake-detail {
			padding: 0.65rem 0.85rem;
			min-height: auto;
			margin-top: 0.5rem;
		}

		.cd-header {
			margin-bottom: 0.2rem;
		}

		.cd-generic {
			font-size: 0.7rem;
		}

		.cd-badge {
			font-size: 0.65rem;
			padding: 0.1rem 0.35rem;
		}

		.cd-name {
			font-size: 0.95rem;
			margin-bottom: 0.25rem;
		}

		.cd-desc {
			font-size: 0.75rem;
			line-height: 1.35;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			margin-bottom: 0.5rem;
		}

		.cd-action-link {
			font-size: 0.75rem;
			padding: 0.35rem 0.65rem;
		}
	}
</style>

<script is:inline>
	(function () {
		const PILLAR_DATA = {
			berita: {
				g: "Pilar 07 • Jurnalisme",
				n: "Berita & Newsroom",
				c: "4.265 Liputan Terbit",
				d: "Laporan berita terhangat, isu kebijakan esensial, peristiwa sosial, dan investigasi mendalam berintegritas.",
				url: "/category/berita"
			},
			game: {
				g: "Pilar 06 • Interaktif",
				n: "Video Game & Esports",
				c: "4.282 Liputan Terbit",
				d: "Review game konsol dan PC, perkembangan industri game global, strategi esports, dan komunitas gamer.",
				url: "/category/game"
			},
			tech: {
				g: "Pilar 05 • Masa Depan",
				n: "Teknologi & Inovasi",
				c: "3.729 Liputan Terbit",
				d: "Kecerdasan buatan, perangkat keras mutakhir, terobosan software, dan perkembangan ekosistem digital dunia.",
				url: "/category/tech"
			},
			musik: {
				g: "Pilar 04 • Audio & Hiburan",
				n: "Musik & Nada",
				c: "3.576 Liputan Terbit",
				d: "Kurasi rilisan musik terkini, ulasan album, profil musisi independen dan arus utama, serta tren audio global.",
				url: "/category/musik"
			},
			budaya: {
				g: "Pilar 03 • Seni & Kultur",
				n: "Seni & Budaya Pop",
				c: "233 Liputan Terbit",
				d: "Eksplorasi fenomena urban, warisan budaya lokal, seni visual, dan dinamika sosial masyarakat modern.",
				url: "/category/budaya"
			},
			kesehatan: {
				g: "Pilar 02 • Gaya Hidup",
				n: "Kesehatan & Kebugaran",
				c: "606 Liputan Terbit",
				d: "Informasi medis terpercaya, wawasan kebugaran fisik dan mental, serta tren hidup sehat tanpa menggurui.",
				url: "/category/kesehatan"
			},
			lab: {
				g: "Pilar 01 • Studio & Hub",
				n: "Tujuhcahaya Media Lab",
				c: "Studio & Hub",
				d: "Pusat eksplorasi media independen, riset konten kreatif, dan fondasi arsitektur digital Tujuhcahaya.",
				url: "/about-us"
			}
		};

		const container = document.getElementById("cakeContainer");
		const detail = document.getElementById("cakeDetail");
		if (!container || !detail) return;

		const layers = Array.from(container.querySelectorAll(".layer"));
		let currentKey = "game";
		let swapTimer = null;

		function renderCard(key) {
			const d = PILLAR_DATA[key];
			if (!d) return;
			const elGeneric = document.getElementById("cdGeneric");
			const elName = document.getElementById("cdName");
			const elDesc = document.getElementById("cdDesc");
			const elCount = document.getElementById("cdCount");
			const elLink = document.getElementById("cdLink");

			if (elGeneric) elGeneric.textContent = d.g;
			if (elName) elName.textContent = d.n;
			if (elDesc) elDesc.textContent = d.d;
			if (elCount) elCount.textContent = d.c;
			if (elLink) elLink.setAttribute("href", d.url);
		}

		function selectLayer(key) {
			const hinting = container.querySelector(".layer.hint");
			if (hinting) hinting.classList.remove("hint");

			const isSwap = key !== currentKey;
			currentKey = key;

			layers.forEach(g => {
				const isTarget = g.getAttribute("data-key") === key;
				if (isTarget && g.classList.contains("sel") && !isSwap) {
					// Toggle back in or out if clicking the already selected slab
					g.classList.toggle("out");
				} else {
					g.classList.toggle("sel", isTarget);
					g.classList.toggle("out", isTarget);
				}
				g.setAttribute("aria-pressed", String(isTarget));
			});

			const hasOut = !!container.querySelector(".layer.out");
			container.classList.toggle("has-out", hasOut);

			if (!isSwap) return;

			clearTimeout(swapTimer);
			detail.classList.add("swap");
			swapTimer = setTimeout(() => {
				renderCard(key);
				detail.classList.remove("swap");
			}, 160);
		}

		function activate(g) {
			container.classList.add("touched");
			selectLayer(g.getAttribute("data-key"));
		}

		layers.forEach((g, idx) => {
			g.addEventListener("click", () => activate(g));
			g.addEventListener("keydown", e => {
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					activate(g);
				} else if (e.key === "ArrowDown") {
					e.preventDefault();
					const nextIdx = (idx + 1) % layers.length;
					layers[nextIdx].focus();
					activate(layers[nextIdx]);
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					const prevIdx = (idx - 1 + layers.length) % layers.length;
					layers[prevIdx].focus();
					activate(layers[prevIdx]);
				}
			});
		});

		// Idle attention hint pulse at 1600ms if not yet interacted
		setTimeout(() => {
			if (container.classList.contains("touched")) return;
			const topLayer = container.querySelector('.layer[data-key="berita"]');
			if (topLayer) {
				topLayer.classList.add("hint");
				topLayer.addEventListener("animationend", () => topLayer.classList.remove("hint"), { once: true });
			}
		}, 1600);
	})();
</script>
