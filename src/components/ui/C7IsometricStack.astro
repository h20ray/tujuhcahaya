---
// Tujuhcahaya - Isometric 3D Layered Architecture Stack ("Cake" Engine)
// 7C Digital Engine with 2:1 dimetric projection and bespoke spring kinematics
// MD3X Color System & WCAG AAA Compliant

import C7IsometricStackLayout from "./isometric/C7IsometricStackLayout.astro";
import C7IsometricGrid from "./isometric/C7IsometricGrid.astro";
import C7IsometricCard from "./isometric/C7IsometricCard.astro";
import { use7cTranslation } from "../../i18n/utils";

interface Props {
	lang?: "id" | "en";
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "id" } = Astro.props;
const isEn = lang === "en";
const { t } = use7cTranslation(lang === "en" ? "en" : "id");

const rubriks = [
	{
		key: "lab",
		num: "01",
		generic: t.isometric.sections[0].generic,
		name: t.isometric.sections[0].name,
		shortLeft: t.isometric.sections[0].shortLeft,
		shortRight: t.isometric.sections[0].shortRight,
		desc: t.isometric.sections[0].desc,
		accent: "var(--7c-pillar-lab, #94a3b8)",
		stroke: "#475569",
		count: t.isometric.sections[0].count,
		url: isEn ? "/en/about-us" : "/about-us",
		y: 276,
	},
	{
		key: "kesehatan",
		num: "02",
		generic: t.isometric.sections[1].generic,
		name: t.isometric.sections[1].name,
		shortLeft: t.isometric.sections[1].shortLeft,
		shortRight: t.isometric.sections[1].shortRight,
		desc: t.isometric.sections[1].desc,
		accent: "var(--7c-pillar-kesehatan, #2dd4bf)",
		stroke: "#0d9488",
		count: t.isometric.sections[1].count,
		url: isEn ? "/en/category/kesehatan" : "/category/kesehatan",
		y: 230,
	},
	{
		key: "budaya",
		num: "03",
		generic: t.isometric.sections[2].generic,
		name: t.isometric.sections[2].name,
		shortLeft: t.isometric.sections[2].shortLeft,
		shortRight: t.isometric.sections[2].shortRight,
		desc: t.isometric.sections[2].desc,
		accent: "var(--7c-pillar-budaya, #fbbf24)",
		stroke: "#d97706",
		count: t.isometric.sections[2].count,
		url: isEn ? "/en/category/budaya" : "/category/budaya",
		y: 184,
	},
	{
		key: "musik",
		num: "04",
		generic: t.isometric.sections[3].generic,
		name: t.isometric.sections[3].name,
		shortLeft: t.isometric.sections[3].shortLeft,
		shortRight: t.isometric.sections[3].shortRight,
		desc: t.isometric.sections[3].desc,
		accent: "var(--7c-pillar-musik, #a78bfa)",
		stroke: "#7c3aed",
		count: t.isometric.sections[3].count,
		url: isEn ? "/en/category/musik" : "/category/musik",
		y: 138,
	},
	{
		key: "tech",
		num: "05",
		generic: t.isometric.sections[4].generic,
		name: t.isometric.sections[4].name,
		shortLeft: t.isometric.sections[4].shortLeft,
		shortRight: t.isometric.sections[4].shortRight,
		desc: t.isometric.sections[4].desc,
		accent: "var(--7c-pillar-tech, #38bdf8)",
		stroke: "#0369a1",
		count: t.isometric.sections[4].count,
		url: isEn ? "/en/category/tech" : "/category/tech",
		y: 92,
	},
	{
		key: "game",
		num: "06",
		generic: t.isometric.sections[5].generic,
		name: t.isometric.sections[5].name,
		shortLeft: t.isometric.sections[5].shortLeft,
		shortRight: t.isometric.sections[5].shortRight,
		desc: t.isometric.sections[5].desc,
		accent: "var(--7c-pillar-game, #34d399)",
		stroke: "#059669",
		count: t.isometric.sections[5].count,
		url: isEn ? "/en/category/game" : "/category/game",
		y: 46,
	},
	{
		key: "berita",
		num: "07",
		generic: t.isometric.sections[6].generic,
		name: t.isometric.sections[6].name,
		shortLeft: t.isometric.sections[6].shortLeft,
		shortRight: t.isometric.sections[6].shortRight,
		desc: t.isometric.sections[6].desc,
		accent: "var(--7c-pillar-berita, #ff5252)",
		stroke: "#be123c",
		count: t.isometric.sections[6].count,
		url: isEn ? "/en/category/berita" : "/category/berita",
		y: 0,
	},
];

const defaultRubrik = rubriks.find((r) => r.key === "game") || rubriks[5];
const serializedRubrikData = Object.fromEntries(
	rubriks.map((r) => [
		r.key,
		{ n: r.name, d: r.desc, url: r.url, accent: r.accent },
	])
);
---

<C7IsometricStackLayout>
	<C7IsometricGrid
		rubriks={rubriks}
		serializedRubrikData={serializedRubrikData}
		ariaLabel={t.isometric.aria_label}
		layerLabel={t.isometric.layer}
	/>
	<C7IsometricCard
		name={defaultRubrik.name}
		desc={defaultRubrik.desc}
		url={defaultRubrik.url}
		accent={defaultRubrik.accent}
	/>
</C7IsometricStackLayout>

<script>
	let currentCleanup: (() => void) | null = null;

	function initCakeWidget(): void {
		if (currentCleanup) {
			currentCleanup();
			currentCleanup = null;
		}

		const container = document.getElementById("cakeContainer");
		const detail = document.getElementById("cakeDetail");
		if (!container || !detail) return;

		const rawRubriks = container.getAttribute("data-rubriks");
		if (!rawRubriks) return;

		let rubrikData: Record<string, { n: string; d: string; url: string; accent: string }> | null = null;
		try {
			rubrikData = JSON.parse(rawRubriks);
		} catch {
			return;
		}
		if (!rubrikData) return;

		const layers = Array.from(container.querySelectorAll<SVGElement>(".layer"));
		let currentKey = "game";
		let swapTimer: ReturnType<typeof setTimeout> | null = null;
		let hintTimer: ReturnType<typeof setTimeout> | null = null;

		function renderCard(key: string): void {
			const d = rubrikData?.[key];
			if (!d) return;
			const elName = document.getElementById("cdName");
			const elDesc = document.getElementById("cdDesc");

			if (detail) {
				detail.setAttribute("href", d.url);
				if (d.accent) {
					detail.style.setProperty("--cd-accent", d.accent);
				}
			}
			if (elName) elName.textContent = d.n;
			if (elDesc) elDesc.textContent = d.d;
		}

		function selectLayer(key: string): void {
			const hinting = container?.querySelector(".layer.hint");
			if (hinting) hinting.classList.remove("hint");

			const isSwap = key !== currentKey;
			currentKey = key;

			layers.forEach((g) => {
				const isTarget = g.getAttribute("data-key") === key;
				if (isTarget && g.classList.contains("sel") && !isSwap) {
					g.classList.toggle("out");
				} else {
					g.classList.toggle("sel", isTarget);
					g.classList.toggle("out", isTarget);
				}
				g.setAttribute("aria-pressed", String(isTarget));
			});

			const hasOut = Boolean(container?.querySelector(".layer.out"));
			container?.classList.toggle("has-out", hasOut);

			if (!isSwap) return;

			if (swapTimer) clearTimeout(swapTimer);
			detail?.classList.add("swap");
			swapTimer = setTimeout(() => {
				renderCard(key);
				detail?.classList.remove("swap");
			}, 160);
		}

		function activate(g: Element): void {
			container?.classList.add("touched");
			const key = g.getAttribute("data-key");
			if (key) selectLayer(key);
		}

		function handleClick(e: MouseEvent): void {
			const target = e.target as Element | null;
			const g = target?.closest(".layer");
			if (g && container?.contains(g)) {
				activate(g);
			}
		}

		function handleKeydown(e: KeyboardEvent): void {
			if (e.key !== "Enter" && e.key !== " " && e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
			const target = e.target as Element | null;
			const g = target?.closest(".layer");
			if (!g || !container?.contains(g)) return;

			const idx = layers.indexOf(g as SVGElement);
			if (idx < 0) return;

			e.preventDefault();

			if (e.key === "Enter" || e.key === " ") {
				activate(g);
			} else if (e.key === "ArrowDown") {
				const nextIdx = (idx + 1) % layers.length;
				layers[nextIdx].focus();
				activate(layers[nextIdx]);
			} else if (e.key === "ArrowUp") {
				const prevIdx = (idx - 1 + layers.length) % layers.length;
				layers[prevIdx].focus();
				activate(layers[prevIdx]);
			}
		}

		container.addEventListener("click", handleClick as EventListener);
		container.addEventListener("keydown", handleKeydown as EventListener);

		hintTimer = setTimeout(() => {
			if (!container || container.classList.contains("touched")) return;
			const topLayer = container.querySelector('.layer[data-key="berita"]');
			if (topLayer) {
				topLayer.classList.add("hint");
				topLayer.addEventListener("animationend", () => topLayer.classList.remove("hint"), { once: true });
			}
		}, 1600);

		currentCleanup = function (): void {
			if (swapTimer) clearTimeout(swapTimer);
			if (hintTimer) clearTimeout(hintTimer);
			container.removeEventListener("click", handleClick as EventListener);
			container.removeEventListener("keydown", handleKeydown as EventListener);
		};
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCakeWidget);
	} else {
		initCakeWidget();
	}


	document.addEventListener("astro:page-load", initCakeWidget);
	document.addEventListener("astro:before-swap", () => {
		if (currentCleanup) {
			currentCleanup();
			currentCleanup = null;
		}
	});
	window.addEventListener("pagehide", () => {
		if (currentCleanup) {
			currentCleanup();
			currentCleanup = null;
		}
	});
</script>
