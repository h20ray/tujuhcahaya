---
interface Props {
	class?: string;
	width?: number | string;
	height?: number | string;
	color?: string;
	ariaHidden?: boolean;
}

const {
	class: className = "",
	width = 36,
	height = 36,
	color = "currentColor",
	ariaHidden = false,
} = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	xml:space="preserve"
	viewBox="0 0 15875 15875"
	width={width}
	height={height}
	class={`c7-logo ${className}`}
	role={ariaHidden ? undefined : "img"}
	aria-label={ariaHidden ? undefined : "Logo Resmi Tujuhcahaya 7C"}
	aria-hidden={ariaHidden ? "true" : undefined}
	style="shape-rendering:geometricPrecision;text-rendering:geometricPrecision;image-rendering:optimizeQuality;fill-rule:evenodd;clip-rule:evenodd;"
>
	<path
		d="M13209.56 2093.57c60.25-170.71 42.67-323.83-52.72-459.4-95.4-135.56-233.46-203.34-414.21-203.34H9820.58L5106.13 14956.64c-70.29 180.74-60.26 341.41 30.12 481.99 90.37 140.57 230.96 210.87 421.74 210.87h2907z"
		fill={color}
		style="fill-rule:nonzero"
	/>
	<path
		d="M4988.18 225.5c1302.14 0 2357.73 1055.59 2357.73 2357.73 0 1302.15-1055.59 2357.73-2357.73 2357.73S2630.45 3885.38 2630.45 2583.23c0-1302.14 1055.59-2357.73 2357.73-2357.73"
		fill={color}
	/>
</svg>
