---
// Tujuhcahaya - Isometric Stack Editorial Detail Panel
// 7C Bespoke clickable category card synchronized with the active layer

export interface Props {
	name: string;
	desc: string;
	url: string;
	accent: string;
}

const { name, desc, url, accent } = Astro.props;
---

<a
	href={url}
	class="cake-detail"
	id="cakeDetail"
	aria-live="polite"
	style={`--cd-accent: ${accent};`}
>
	<h3 class="cd-name" id="cdName">{name}</h3>
	<p class="cd-desc" id="cdDesc">{desc}</p>
</a>

<style>
	.cake-detail {
		margin-top: auto;
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: 0;
		padding: 1rem 1.25rem;
		background: var(--color-card);
		text-decoration: none;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		justify-content: center;
		transition: opacity 160ms ease, transform 160ms ease, border-color 0.2s ease, background-color 0.2s ease;
		min-height: 105px;
	}

	:global([data-theme="dark"]) .cake-detail {
		background: #0f1218;
		border-color: rgba(255, 255, 255, 0.1);
	}

	.cake-detail:hover {
		border-color: var(--cd-accent, var(--color-primary));
		background: var(--color-card-subtle, rgba(0, 0, 0, 0.02));
	}

	:global([data-theme="dark"]) .cake-detail:hover {
		background: #141822;
		border-color: var(--cd-accent, rgba(255, 255, 255, 0.25));
	}

	.cake-detail:focus-visible {
		outline: none;
		border-color: var(--cd-accent, var(--7c-sys-primary));
		box-shadow: 0 0 0 3px rgba(213, 0, 0, 0.12), var(--7c-sys-elevation-2);
	}

	:global([data-theme="dark"]) .cake-detail:focus-visible {
		border-color: var(--cd-accent, rgba(255, 82, 82, 0.35));
		box-shadow: 0 0 0 3px rgba(255, 82, 82, 0.18), var(--7c-sys-elevation-2);
	}

	.cake-detail.swap {
		opacity: 0;
		transform: translateY(6px);
	}

	.cd-name {
		font-family: var(--7c-font-display, "Google Sans", system-ui, sans-serif);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--color-text);
		margin: 0 0 0.35rem 0;
		transition: color 0.2s ease;
	}

	.cake-detail:hover .cd-name {
		color: var(--cd-accent, var(--color-primary));
	}

	.cd-desc {
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 991px) {
		.cake-detail {
			padding: 0.65rem 0.85rem;
			min-height: auto;
			margin-top: 0.5rem;
		}

		.cd-name {
			font-size: 0.95rem;
			margin-bottom: 0.2rem;
		}

		.cd-desc {
			font-size: 0.75rem;
			line-height: 1.35;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			margin: 0;
		}
	}
</style>
