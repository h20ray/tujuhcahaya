---
interface Props {
	label: string;
	slug?: string;
	pillar?: "berita" | "game" | "tech" | "musik" | "budaya" | "kesehatan" | "lab" | string;
	href?: string;
	class?: string;
}

const {
	label,
	pillar = "berita",
	href,
	class: className = "",
} = Astro.props;

// Determine normalized pillar key
const normalizedPillar = pillar.toLowerCase().trim();
---

{
	href ? (
		<a
			href={href}
			class={`c7-badge c7-badge-${normalizedPillar} ${className}`}
		>
			<span class="c7-badge-dot" aria-hidden="true" />
			<span class="c7-badge-text">{label}</span>
		</a>
	) : (
		<span class={`c7-badge c7-badge-${normalizedPillar} ${className}`}>
			<span class="c7-badge-dot" aria-hidden="true" />
			<span class="c7-badge-text">{label}</span>
		</span>
	)
}

<style>
	.c7-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		line-height: 1;
		border: 1px solid var(--7c-sys-outline-variant);
		background-color: var(--7c-sys-surface-container-high);
		color: var(--7c-sys-on-surface);
		transition: all 0.15s ease;
		text-decoration: none;
		width: fit-content;
	}

	.c7-badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		display: inline-block;
		background-color: var(--7c-sys-primary);
	}

	/* MD3X Pillar Spectrum Color Alignments */
	.c7-badge-berita {
		border-color: rgba(213, 0, 0, 0.35);
		background-color: rgba(213, 0, 0, 0.08);
		color: var(--7c-pillar-berita);
	}
	.c7-badge-berita .c7-badge-dot { background-color: var(--7c-pillar-berita); }

	.c7-badge-game {
		border-color: rgba(5, 150, 105, 0.35);
		background-color: rgba(5, 150, 105, 0.08);
		color: var(--7c-pillar-game);
	}
	.c7-badge-game .c7-badge-dot { background-color: var(--7c-pillar-game); }

	.c7-badge-tech {
		border-color: rgba(2, 132, 199, 0.35);
		background-color: rgba(2, 132, 199, 0.08);
		color: var(--7c-pillar-tech);
	}
	.c7-badge-tech .c7-badge-dot { background-color: var(--7c-pillar-tech); }

	.c7-badge-musik {
		border-color: rgba(124, 58, 237, 0.35);
		background-color: rgba(124, 58, 237, 0.08);
		color: var(--7c-pillar-musik);
	}
	.c7-badge-musik .c7-badge-dot { background-color: var(--7c-pillar-musik); }

	.c7-badge-budaya {
		border-color: rgba(217, 119, 6, 0.35);
		background-color: rgba(217, 119, 6, 0.08);
		color: var(--7c-pillar-budaya);
	}
	.c7-badge-budaya .c7-badge-dot { background-color: var(--7c-pillar-budaya); }

	.c7-badge-kesehatan {
		border-color: rgba(13, 148, 136, 0.35);
		background-color: rgba(13, 148, 136, 0.08);
		color: var(--7c-pillar-kesehatan);
	}
	.c7-badge-kesehatan .c7-badge-dot { background-color: var(--7c-pillar-kesehatan); }

	.c7-badge-lab {
		border-color: rgba(71, 85, 105, 0.35);
		background-color: rgba(71, 85, 105, 0.08);
		color: var(--7c-pillar-lab);
	}
	.c7-badge-lab .c7-badge-dot { background-color: var(--7c-pillar-lab); }

	/* Hover interaction */
	a.c7-badge:hover {
		transform: translateY(-1px);
		border-color: var(--7c-sys-primary);
	}
</style>
