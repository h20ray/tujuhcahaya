---
interface Props {
	label: string;
	slug?: string;
	pillar?: "berita" | "game" | "tech" | "musik" | "budaya" | "kesehatan" | "lab" | string;
	href?: string;
	class?: string;
}

const {
	label,
	pillar = "berita",
	href,
	class: className = "",
} = Astro.props;

// Determine normalized pillar key
const normalizedPillar = pillar.toLowerCase().trim();
---

{
	href ? (
		<a
			href={href}
			class={`c7-badge c7-badge-${normalizedPillar} ${className}`}
		>
			<span class="c7-badge-dot" aria-hidden="true" />
			<span class="c7-badge-text">{label}</span>
		</a>
	) : (
		<span class={`c7-badge c7-badge-${normalizedPillar} ${className}`}>
			<span class="c7-badge-dot" aria-hidden="true" />
			<span class="c7-badge-text">{label}</span>
		</span>
	)
}

<style>
	.c7-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		vertical-align: middle;
		gap: 0.35rem;
		padding: 0.22rem 0.6rem;
		border-radius: 9999px;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		line-height: 1;
		border: none;
		background-color: var(--7c-sys-surface-container-high);
		color: var(--7c-sys-on-surface);
		transition: all 0.15s cubic-bezier(0.2, 0, 0, 1);
		text-decoration: none;
		width: fit-content;
		box-sizing: border-box;
	}

	.c7-badge-text {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		text-align: center;
	}

	.c7-badge-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		display: inline-block;
		background-color: var(--7c-sys-primary);
		flex-shrink: 0;
	}

	/* MD3X Pillar Spectrum Color Alignments */
	.c7-badge-berita {
		background-color: rgba(213, 0, 0, 0.1);
		color: var(--7c-pillar-berita);
	}
	.c7-badge-berita .c7-badge-dot { background-color: var(--7c-pillar-berita); }

	.c7-badge-game {
		background-color: rgba(5, 150, 105, 0.1);
		color: var(--7c-pillar-game);
	}
	.c7-badge-game .c7-badge-dot { background-color: var(--7c-pillar-game); }

	.c7-badge-tech {
		background-color: rgba(2, 132, 199, 0.1);
		color: var(--7c-pillar-tech);
	}
	.c7-badge-tech .c7-badge-dot { background-color: var(--7c-pillar-tech); }

	.c7-badge-musik {
		background-color: rgba(124, 58, 237, 0.1);
		color: var(--7c-pillar-musik);
	}
	.c7-badge-musik .c7-badge-dot { background-color: var(--7c-pillar-musik); }

	.c7-badge-budaya {
		background-color: rgba(217, 119, 6, 0.1);
		color: var(--7c-pillar-budaya);
	}
	.c7-badge-budaya .c7-badge-dot { background-color: var(--7c-pillar-budaya); }

	.c7-badge-kesehatan {
		background-color: rgba(13, 148, 136, 0.1);
		color: var(--7c-pillar-kesehatan);
	}
	.c7-badge-kesehatan .c7-badge-dot { background-color: var(--7c-pillar-kesehatan); }

	.c7-badge-lab {
		background-color: rgba(71, 85, 105, 0.12);
		color: var(--7c-pillar-lab);
	}
	.c7-badge-lab .c7-badge-dot { background-color: var(--7c-pillar-lab); }

	/* Dark mode container elevation */
	:global([data-theme="dark"]) .c7-badge-berita { background-color: rgba(255, 82, 82, 0.16); }
	:global([data-theme="dark"]) .c7-badge-game { background-color: rgba(52, 211, 153, 0.16); }
	:global([data-theme="dark"]) .c7-badge-tech { background-color: rgba(56, 189, 248, 0.16); }
	:global([data-theme="dark"]) .c7-badge-musik { background-color: rgba(167, 139, 250, 0.16); }
	:global([data-theme="dark"]) .c7-badge-budaya { background-color: rgba(251, 191, 36, 0.16); }
	:global([data-theme="dark"]) .c7-badge-kesehatan { background-color: rgba(45, 212, 191, 0.16); }
	:global([data-theme="dark"]) .c7-badge-lab { background-color: rgba(148, 163, 184, 0.16); }

	/* Hover and focus interactions */
	a.c7-badge:hover {
		transform: translateY(-1px);
		filter: brightness(0.92);
	}

	a.c7-badge:focus-visible {
		outline: none;
		box-shadow: var(--7c-sys-focus-ring);
	}
</style>
