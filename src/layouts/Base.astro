---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import C7ResizableNavbar from "../components/navigation/C7ResizableNavbar.astro";
import C7CommandPalette from "../components/navigation/C7CommandPalette.astro";
import C7Footer from "../components/navigation/C7Footer.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { C7RadioPlayer } from "@tujuhcahaya/radio-player/client";
import C7LiveChat from "@tujuhcahaya/live-chat/astro";
import "@tujuhcahaya/live-chat/styles.css";
import C7DispatchDrawer from "../components/editorial/C7DispatchDrawer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	isHome?: boolean;
}

const { title, pageTitle, description, image, canonical, content, isHome: propIsHome } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

import { get7cLocaleFromUrl, use7cTranslation } from "../i18n/utils";
import { get7cHreflangLinks } from "../lib/7c-seo";

const currentPath = Astro.url.pathname;
const locale = get7cLocaleFromUrl(Astro.url);
const { t } = use7cTranslation(locale);
const isHome = propIsHome ?? (currentPath === "/" || currentPath === "" || currentPath === "/en" || currentPath === "/en/");
const hreflangLinks = !content ? get7cHreflangLinks(currentPath, Astro.url.origin) : [];

const currentDateStr = new Date().toLocaleDateString(locale === "en" ? "en-US" : "id-ID", {
	weekday: "long",
	year: "numeric",
	month: "long",
	day: "numeric",
});

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		
		<!-- 7C Bespoke Engine Signature -->
		<meta name="generator" content="7C Digital Engine (Astro + EmDash)" />
		<meta name="author" content="Tujuhcahaya" />

		<!-- Google Sans Typography Suite (blog.google Benchmark) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css?family=Google+Sans:400,500,600,700|Google+Sans+Text:400,500,700|Product+Sans:400,700&display=swap&lang=en"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<link rel="preconnect" href="https://media.xlocal.id" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Multilingual Hreflang Alternates for Static / Taxonomy Routes -->
		{!content && hreflangLinks.map((item) => (
			<link rel={item.rel} hreflang={item.hreflang} href={item.href} />
		))}

		<EmDashHead page={pageCtx} />
		<ClientRouter />

		<script is:inline>
			// Instant theme initialization to prevent flash (FOUC)
			(() => {
				try {
					const saved = localStorage.getItem("theme");
					const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					if (saved === "dark" || ((!saved || saved === "system") && prefersDark)) {
						document.documentElement.setAttribute("data-theme", "dark");
					} else {
						document.documentElement.removeAttribute("data-theme");
					}
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<!-- WCAG 2.4.1 Skip to Main Content Link -->
		<a href="#main-content" class="c7-skip-link skip-link">
			{t.a11y.skip_to_content}
		</a>

		<!-- 7C Resizable Navbar (Centered Dynamic Pill with Frosted Blur & News Mega Menu) -->
		<C7ResizableNavbar currentPath={currentPath} currentDateStr={currentDateStr} locale={locale} menu={menu} />

		<div class:list={["c7-hairline-container", "hairline-container", { "c7-hairline-home": isHome }]}>
			<!-- Main Body Content Slot (WCAG Landmark) -->
			<main id="main-content" tabindex="-1">
				<slot />
			</main>
		</div>

		<!-- blog.google Minimalist Uni-Footer (Edge-to-Edge) -->
		<C7Footer locale={locale} />

		<!-- 7C Radio Player Bottom Spacer (Prevents footer and content clipping) -->
		<div class="c7-radio-bottom-spacer" aria-hidden="true" transition:persist="c7-radio-spacer"></div>

		<script data-search-label={t.a11y.search_articles}>
			function setupInteractions() {
				// Mobile Menu Drawer Handler
				const mobileMenuToggle = document.getElementById("c7-mobile-menu-toggle");
				const mobileDrawer = document.getElementById("c7-mobile-drawer");
				const openIcon = mobileMenuToggle?.querySelector(".c7-menu-open-icon");
				const closeIcon = mobileMenuToggle?.querySelector(".c7-menu-close-icon");

				function toggleMobileDrawer(open) {
					if (!mobileDrawer || !mobileMenuToggle) return;
					const shouldOpen = open !== undefined ? open : mobileDrawer.hidden;
					mobileDrawer.hidden = !shouldOpen;
					mobileMenuToggle.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
					if (openIcon && closeIcon) {
						openIcon.style.display = shouldOpen ? "none" : "block";
						closeIcon.style.display = shouldOpen ? "block" : "none";
					}
				}

				mobileMenuToggle?.addEventListener("click", () => {
					toggleMobileDrawer();
				});

				// Close mobile drawer on escape
				window.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && mobileDrawer && !mobileDrawer.hidden) {
						toggleMobileDrawer(false);
					}
				});

				// Close mobile drawer when clicking a mobile nav link
				document.querySelectorAll(".c7-mobile-nav-item").forEach((link) => {
					link.addEventListener("click", () => {
						toggleMobileDrawer(false);
					});
				});

				// Ensure search input has an accessible label for screen readers
				function checkSearchInputLabel() {
					const searchInputs = document.querySelectorAll(".emdash-live-search-input");
					const scriptEl = document.currentScript;
					const labelText = scriptEl?.dataset.searchLabel || "Search articles or stories";
					searchInputs.forEach((input) => {
						if (!input.getAttribute("aria-label")) {
							input.setAttribute("aria-label", labelText);
						}
					});
				}
				checkSearchInputLabel();
			}

			// Run on initial page load and on every View Transitions page swap
			document.addEventListener("astro:page-load", setupInteractions);

			// 7C Live Chat Drawer Toggle (persistent panel across navigation)
			function setupChatToggle() {
				const toggle = document.getElementById("c7-chat-toggle");
				const panel = document.getElementById("c7-chat-panel");
				if (!toggle || !panel || toggle.dataset.c7ChatBound === "true") return;
				toggle.dataset.c7ChatBound = "true";

				const setOpen = (open) => {
					panel.hidden = !open;
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
				};

				toggle.addEventListener("click", () => setOpen(panel.hidden));

				window.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && !panel.hidden) {
						setOpen(false);
						toggle.focus();
					}
				});
			}

			document.addEventListener("astro:page-load", setupChatToggle);

			// Reset body scroll position on View Transitions page swap
			document.addEventListener("astro:after-swap", () => {
				document.body.scrollTop = 0;
			});
		</script>

		<!-- 7C Bespoke Command Palette (Fullscreen Keyboard-Driven Search & Actions) -->
		<C7CommandPalette locale={locale} />

		<!-- 7C Radio Player Floating Dock (Persistent across page navigation) -->
		<C7RadioPlayer client:only="react" transition:persist="c7-radio-player" />

		<!-- 7C Live Chat Drawer (Persistent across page navigation) -->
		<button
			type="button"
			class="c7-chat-toggle"
			id="c7-chat-toggle"
			aria-controls="c7-chat-panel"
			aria-expanded="false"
			aria-label={t.a11y.open_live_chat}
			transition:persist="c7-chat-toggle"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
			</svg>
			<span>{t.a11y.live_chat_title}</span>
		</button>
		<div
			class="c7-chat-panel"
			id="c7-chat-panel"
			hidden
			transition:persist="c7-chat-panel"
		>
			<C7LiveChat
				roomId="utama"
				title={t.a11y.live_chat_title}
				stationName={siteTitle}
			/>
		</div>

		<!-- 7C Dispatch Article Preview Slide-over Drawer -->
		<C7DispatchDrawer locale={locale} />

		<!-- 7C Theme Controller (ClientRouter Lifecycle & Persistence) -->
		<script src="../scripts/7c-theme.ts"></script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style>
	/* 7C Live Chat Drawer (scoped to Base layout) */
	.c7-chat-toggle {
		position: fixed;
		right: 1rem;
		bottom: 8.5rem;
		z-index: 45;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--7c-sys-outline-variant, rgba(0, 0, 0, 0.12));
		border-radius: 9999px;
		background-color: var(--7c-sys-surface-container-high, #f8fafc);
		color: var(--7c-sys-on-surface, #1e293b);
		font-size: 0.8125rem;
		font-weight: 700;
		cursor: pointer;
		box-shadow: 0 4px 16px -6px rgba(0, 0, 0, 0.18);
	}

	.c7-chat-toggle:focus-visible {
		outline: 2px solid var(--7c-sys-primary);
		outline-offset: 3px;
	}

	.c7-chat-panel {
		position: fixed;
		right: 1rem;
		bottom: 12rem;
		z-index: 46;
		width: min(380px, calc(100vw - 2rem));
		height: min(560px, 70vh);
		overflow: hidden;
		border-radius: 20px;
	}

	@media (max-width: 640px) {
		.c7-chat-panel {
			right: 0;
			bottom: 0;
			width: 100vw;
			height: 75vh;
			border-radius: 20px 20px 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.c7-chat-toggle {
			transition: none;
		}
	}
</style>
